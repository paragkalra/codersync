#!/usr/bin/env bash
# Usage: codersync --setup|-s <ssh-target> [remote-dir]
#        codersync <session-name> [--split-mode|-m iterm|tmux] [--tools|-t t1,t2] [--safe-mode|-s]
#        codersync --attach|-a <id-or-name>
#        codersync --rename|-R <id-or-name> <new-name>
#        codersync --restore-all|-r
#        codersync --list-all|-l
#        codersync --kill|-k <ids>   (e.g. 1,2,4 or 1-4)
#        codersync --kill-all|-K
#        codersync --paste-image|-p
#        codersync --sync-skills|-y
#        codersync --local|-L <session-name> [--tools|-t t1,t2] [--safe-mode|-s]
#        codersync --adopt|-d
#
# Every flag above has a single-letter short form -- --setup/-s and
# --safe-mode/-s share the letter "s" deliberately: they're parsed in
# two entirely separate contexts (top-level dispatch decides
# --setup-vs-a-session-name first; --safe-mode only exists within a
# session-name invocation's own options), so there's no ambiguity in
# practice, only in a skim of this comment.
#
# One-time setup: `codersync --setup <ssh-target> [remote-dir]` records
# which remote box to use.
#   <ssh-target>  a plain hostname, `user@host`, or an alias from your
#                 own ~/.ssh/config -- restricted to letters, digits, and
#                 . _ - @ (narrower than everything `ssh` itself accepts;
#                 see validate_ssh_target() below for why). Forms like
#                 `host:2222` or a bracketed IPv6 address aren't accepted
#                 directly -- put those in a ~/.ssh/config Host alias and
#                 pass the alias here instead. This also becomes the
#                 label used to prefix session names (see below) -- any
#                 `@`, `.`, or `/` in it are replaced with `-`, since
#                 tmux's own -t target syntax uses `.` as a separator and
#                 a literal one in a session name breaks lookups.
#   [remote-dir]  where claude/codex start (default: ~, the remote
#                 user's home directory)
# Setup checks the box is reachable over SSH and has tmux, bash, and
# base64 installed, before saving anything. [remote-dir] itself isn't
# checked for existence -- ~ always exists, and if you pass a custom
# one, that's on you to get right. Config lives at
# ~/.config/codersync/config.
#
# codersync has no dependency on any specific remote/cloud-dev provider
# -- it works with any box reachable over plain SSH that has tmux. As an
# optional convenience, if <ssh-target> matches the alias pattern used by
# the Coder platform (coder.com) -- `coder.*` -- and its CLI is installed
# locally, setup will offer to run `coder config-ssh` for you first, in
# case that alias doesn't exist yet (you'll be asked to confirm).
#
# Normal usage: `codersync <session-name>` opens a new tab and does all
# its work there, leaving whatever tab you ran it from untouched -- via
# iTerm2 when it's installed, or by printing the attach command for you
# to run yourself otherwise (see the --split-mode note below). The
# configured ssh-target (sanitized as above) is folded into the session
# name by default (e.g. `codersync foo` on target `devbox.example.com`
# becomes session `devbox-example-com-foo`), so names/tabs/tmux sessions
# stay unambiguous if you use codersync against more than one box.
#
# By default (`--split-mode tmux`), this creates ONE tmux session
# (`pair-<session-name>`) with claude/codex as two panes split
# server-side (`tmux split-window`) -- both left as plain idle shells at
# creation, only started AFTER a real client attaches (see below). The
# local side then only needs to open a tab and run a single attach
# command -- no local SPLIT at all. It still uses iTerm2 to open that tab
# automatically when iTerm2 is installed, but doesn't require it: without
# iTerm2, this mode prints the attach command instead of failing, so it
# works from any terminal you paste that command into.
#
# `--split-mode iterm` is the alternative: two separate tmux sessions
# (`claude-<session-name>`, `codex-<session-name>`) instead of one,
# split locally by iTerm2 rather than server-side by tmux. Lets you
# attach to just claude or just codex independently from elsewhere,
# but requires iTerm2. Uses iTerm2's native scripting API (`write text`
# on a specific session reference) instead of simulated keystrokes: it's
# synchronous and targets an exact pane, so there's no split/resize
# timing to race and no Accessibility permission needed (just a one-time
# Automation-permission prompt for controlling iTerm2).
#
# `--tools t1,t2` overrides which two CLI agents run left/right (default:
# `claude,codex`). Each of t1/t2 is either a known short key (`claude`,
# `codex`, `agy`, `aider`, `kimi` -- these auto-append that tool's
# skip-approval flag, see resolve_tool()) or, if unrecognized, a literal
# command run as-is -- so any CLI agent works even without a short key,
# e.g. `--tools claude,'some-other-agent --whatever-flag'`, as long as
# you give the exact command including its own skip-approval flag. Same
# tool twice also works, e.g. `--tools claude,claude`. A literal command
# can't contain a comma (it's the t1/t2 separator, with no escaping),
# and exactly one comma (or zero) is required -- see
# tools_split_is_valid() for what's rejected and why.
#
# `--safe-mode` drops the auto-approve flag for known keys (claude,
# codex, agy, aider, kimi), so normal permission prompts apply instead.
# Only affects known keys -- for a raw/literal --tools command, just
# don't include a skip-approval flag in it yourself.
#
# Both sessions are left idle at creation (not started with the tool
# already running) because tmux creates detached sessions at its
# default-size (80x24) before any client attaches. If the tool's TUI does
# its first render at that size and then gets resized on attach, the
# resize/redraw can come out visually broken. Starting each tool only
# after its pane has attached and settled at its real size avoids that
# resize-during-startup path entirely.
#
# Rather than guessing a fixed delay between "attach" and "start the
# tool", a tmux `client-attached` hook fires the launch at the exact
# moment a real client attaches, then removes itself so later reattaches
# don't relaunch the tool on top of an already-running session.
#
# Note for anyone using the Coder platform (coder.com) specifically:
# prefer routing through a real OpenSSH alias (from `coder config-ssh`)
# rather than wrapping `coder ssh <box>` directly. `coder ssh` has its own pty
# implementation that reports a fixed, wrong terminal size (128x128) to
# the remote host regardless of the real pane size; real OpenSSH's
# pty/window-size negotiation doesn't have that problem.
#
# Each pane's attach command runs in a `while true` retry loop, so if the
# SSH connection drops for any reason -- laptop sleep, wifi blip, VPN
# reconnect -- it automatically reattaches a couple seconds after the
# connection is back, picking back up the same tmux session (and its
# full scrollback/state) with no manual intervention.
#
# Every session name is appended to a local registry
# (~/.codersync_sessions), tagged with the ssh-target it was created
# against, the first time it's used. `codersync --restore-all` reads
# that registry, checks which entries for the CURRENTLY configured
# target are still actually alive there (pruning any that aren't) and
# reopens a tab for each survivor -- meant for recovering after your
# terminal gets closed: nothing on the box was ever lost, this just
# recreates the local tabs. Entries for a different target (from before
# a later --setup pointed elsewhere) are left untouched either way,
# since their aliveness can't be checked without connecting there.
#
# NOTE ssh gotcha worth knowing if you touch this script: passing a
# remote command to ssh as multiple separate arguments makes ssh rejoin
# them with plain spaces before the remote shell sees them, so any piece
# that relies on its own quoting (e.g. a tmux format string starting with
# `#`) loses that quoting in transit and gets mangled (`#` gets parsed as
# a shell comment remotely). Always pass such remote commands as ONE
# pre-quoted string argument instead.
#
# Requires: tmux, bash, and base64 on the remote box (all checked by
# --setup). iTerm2 is only required for `--split-mode iterm`. `coder`
# CLI is only used opportunistically during setup, if applicable -- see
# above.

set -euo pipefail

CONFIG_DIR="$HOME/.config/codersync"
CONFIG_FILE="$CONFIG_DIR/config"
REGISTRY="$HOME/.codersync_sessions"
NEXT_ID_FILE="$CONFIG_DIR/next_id"
PENDING_FILE="$CONFIG_DIR/pending"

# How long a pending marker (see mark_pending below) is honored before
# restore_all treats it as stale and prunable like any other dead entry.
# Needs to comfortably cover a normal remote_setup/remote_setup_tmux_mode
# SSH round-trip, but not so long that a marker orphaned by a hard crash
# (kill -9 -- the EXIT trap that would normally clear_pending never runs)
# blocks --restore-all from ever pruning that entry again.
PENDING_TTL_SECONDS=600

# Input validation, all for the same reason: ssh-target, remote-dir, and
# session names all eventually get interpolated UNQUOTED into a heredoc
# sent to `bash -s` on the remote box (needed so this script's own local
# variables substitute before the heredoc is sent -- see the ssh gotcha
# note near the top of this file). That means any of these containing a
# shell metacharacter doesn't just misbehave, it runs on the remote box:
# confirmed live, `codersync 'x; touch /tmp/pwn'` created that file
# remotely. Restricting each to a safe, realistic character set up front
# is far more robust than trying to out-escape arbitrary input through
# the several nested quoting layers these values pass through (that
# approach has already produced multiple real bugs in this codebase).
# A flat character-class check (any mix of the allowed characters, any
# order) still let through values that are safe-charset but not a
# plausible host: a leading `-` (which ssh/scp can interpret as an
# OPTION rather than a hostname -- confirmed live, `ssh -- -oProxyCommand=...`
# style values reach ssh unquoted further down), `@` or `...` alone, and
# `user@@host` (two `@`s). This requires an optional `user@` part (itself
# starting and ending with an alphanumeric) followed by a host part that
# also starts and ends with an alphanumeric -- so a bare `-`, leading/
# trailing `.`/`-`, and a doubled `@` are all rejected, while normal
# hostnames, IPs, and user@host forms (including internal dots/dashes)
# still pass.
validate_ssh_target() {
  [[ "$1" =~ ^([A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?@)?[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?$ ]]
}

# Rejects a LEADING dash specifically (dashes elsewhere are still fine,
# e.g. "my-project-dir") -- without this, a value like "-", "-P", or
# "--" passed the flat character check, then reached `cd ${remote_dir}`
# unquoted in setup()'s existence check, where a leading dash is read
# by `cd` itself as an OPTION (`-P`, `--`, or the special `cd -` form)
# rather than a literal directory -- so the check could report success
# without ever actually proving anything about a real path, undermining
# the whole point of that check for exactly the malformed input it's
# meant to catch.
validate_remote_dir() {
  [[ "$1" =~ ^[A-Za-z0-9_./~][A-Za-z0-9_./~-]*$ ]]
}

# Deliberately excludes `.` too, even though it might look path-safe,
# because tmux's own -t target parser treats `.` as the window/pane
# separator (see sanitize_label() above) -- a literal one breaks tmux
# target resolution the same way regardless of whether it came from the
# ssh-target or a user-supplied session name.
#
# Also rejects a LEADING dash specifically (dashes elsewhere are still
# fine, e.g. "my-feature") -- without this, `codersync --typo` or
# `codersync --safe-mode` (a real flag, just missing its session-name
# argument) silently fell through to being treated as a literal session
# name instead of an unrecognized/malformed invocation, since nothing
# else in the dispatch distinguishes "meant as a flag" from "meant as a
# name" besides this character check.
validate_session_name() {
  [[ "$1" =~ ^[A-Za-z0-9_][A-Za-z0-9_-]*$ ]]
}

setup() {
  local target="${1:-}"
  local remote_dir="${2:-~}"

  # `help`/`--help`/`-h` here is almost certainly someone reaching for
  # `codersync --setup help` the way many CLIs support `<command> help`,
  # not an actual hostname -- without this, "help" passes
  # validate_ssh_target (it's just letters) and this tries a real SSH
  # connection to a host literally named "help", failing with a
  # connectivity error that explains nothing about --setup itself.
  if [[ -z "$target" || "$target" == "help" || "$target" == "--help" || "$target" == "-h" ]]; then
    echo "Usage: codersync --setup|-s <ssh-target> [remote-dir]" >&2
    echo "  <ssh-target>  a hostname, user@host, or ~/.ssh/config alias (e.g. devbox.example.com)" >&2
    echo "  [remote-dir]  where the agents start on that box (default: ~, your home directory there)" >&2
    echo "Example: codersync --setup devbox.example.com" >&2
    exit 1
  fi

  if ! validate_ssh_target "$target"; then
    echo "Invalid ssh-target '${target}': only letters, digits, and . _ - @ are allowed." >&2
    exit 1
  fi

  if ! validate_remote_dir "$remote_dir"; then
    echo "Invalid remote-dir '${remote_dir}': only letters, digits, and . _ - / ~ are allowed." >&2
    exit 1
  fi

  if [[ "$target" == coder.* ]] && command -v coder >/dev/null 2>&1; then
    if ! grep -q '^Host coder\.' "$HOME/.ssh/config" 2>/dev/null; then
      echo "${target} looks like a coder workspace alias -- running 'coder config-ssh' to set up the proxy (you'll be asked to confirm)."
      coder config-ssh
    fi
  fi

  echo "Checking connectivity to ${target}..."
  if ! ssh -o ConnectTimeout=10 -o BatchMode=yes "$target" -- true 2>/dev/null; then
    echo "Could not reach ${target} over SSH. Confirm the host/alias is correct and reachable." >&2
    exit 1
  fi

  # `ssh host -- command -v X`, unlike an actual interactive login to
  # that box, runs a non-interactive shell that doesn't source
  # ~/.bashrc/~/.profile -- so a tool installed somewhere only added to
  # PATH by one of those (e.g. ~/.local/bin, the default install
  # location for pipx/pip --user/npm-with-a-user-prefix/etc.) reports as
  # missing here even though it works fine in a real interactive
  # session (confirmed live: claude/codex installed under
  # ~/.local/bin). The `PATH=... command` prefix-assignment form sets
  # PATH for just that one command, same idea as every other remote
  # existence check in this file.
  echo "Checking tmux is available on ${target}..."
  if ! ssh "$target" -- 'PATH="$HOME/.local/bin:$HOME/bin:$PATH" command -v tmux' >/dev/null 2>&1; then
    echo "tmux isn't installed on ${target}. Install it there (e.g. 'sudo apt install tmux') and re-run setup." >&2
    exit 1
  fi

  # remote_setup/remote_setup_tmux_mode/remote_kill_session all run
  # `ssh ... -- bash -s <<EOF` to create/kill sessions -- checked here,
  # not just tmux, since a box with tmux but no bash (unusual, but not
  # impossible on a minimal image) would otherwise fail opaquely on the
  # very first `codersync <name>` invocation instead of during setup.
  echo "Checking bash is available on ${target}..."
  if ! ssh "$target" -- 'PATH="$HOME/.local/bin:$HOME/bin:$PATH" command -v bash' >/dev/null 2>&1; then
    echo "bash isn't installed on ${target}. Install it there and re-run setup." >&2
    exit 1
  fi

  # remote_setup/remote_setup_tmux_mode/remote_kill_session also pipe
  # through `base64 -d` remotely (see b64()'s comment for why -- it's
  # how a resolved --tools command or a session name survives the
  # several nested shell-quoting layers between here and the remote
  # pane) -- checked for the same reason as bash above: fail here, not
  # opaquely on the first real invocation. Actually round-trips a value
  # through encode+decode rather than just `command -v base64`: a
  # binary NAMED base64 existing doesn't guarantee it supports the
  # specific `-d` decode form this tool relies on (a non-GNU/minimal
  # one could accept different flags, or none at all).
  echo "Checking base64 is available on ${target}..."
  # PATH-prefixed like the tmux/bash checks above, and for a slightly
  # different reason than those: the actual runtime `base64 -d` calls
  # (inside the bash -s heredocs) already run with this same extended
  # PATH, via the `export PATH=...` those heredocs set at the top --
  # without it here too, this check could be STRICTER than reality,
  # rejecting a box where base64 only lives under ~/.local/bin even
  # though the real remote_setup/remote_setup_tmux_mode calls would
  # have worked fine.
  if ! ssh "$target" -- 'PATH="$HOME/.local/bin:$HOME/bin:$PATH" test "$(printf codersync | base64 | base64 -d)" = codersync' 2>/dev/null; then
    echo "base64 on ${target} doesn't support the 'base64 -d' decode form codersync needs (or isn't installed at all). Install a compatible base64 (e.g. GNU coreutils) and re-run setup." >&2
    exit 1
  fi

  # No existence check for [remote-dir] here (there used to be one, via
  # `cd`, since `tmux new-session -c <bad-dir>` doesn't actually fail on
  # a bad directory -- it silently falls back to a default instead).
  # Dropped because the default is now `~`, which always exists, and a
  # custom [remote-dir] is the user's own responsibility to get right --
  # not something worth an extra SSH round-trip and a remote-box
  # dependency on `cd` behaving a certain way just to double-check it.
  mkdir -p "$CONFIG_DIR"
  # printf %q, not naive quoting: load_config() parses this file itself
  # (see its own comment for why it no longer sources it), but %q is
  # still the right way to write it for two reasons. (a) A REMOTE_DIR
  # value starting with `~` needs to stay literal here so the REMOTE
  # shell -- not this one -- is what expands it later; %q escapes the
  # `~` for exactly that. (b) A naive quoting scheme breaks, or with a
  # crafted value injects, if the value contains its own quote character
  # (e.g. a real path like /home/o'brien/repos); %q handles that
  # correctly too. validate_ssh_target/validate_remote_dir above already
  # reject quote characters, so this is defense in depth, not the only
  # thing standing between untrusted input and this file.
  {
    printf 'SSH_TARGET=%q\n' "$target"
    printf 'REMOTE_DIR=%q\n' "$remote_dir"
  } > "$CONFIG_FILE"
  echo "Done. codersync will use ${target} for claude-<session>/codex-<session>, starting in ${remote_dir}."
}

# Sanitizes a string for use in session/tab names. In particular, tmux's
# -t target-string parser uses `.` as the window/pane separator, so a
# literal dot anywhere in a session name breaks target resolution
# unpredictably (confirmed: `claude-devbox.local-foo` got silently
# mis-parsed down to just `local-foo`). @, :, and / are also separators
# elsewhere (paths, host:port), so all four are swapped for `-`. Pulled
# out as its own function so it's unit-testable in isolation.
sanitize_label() {
  local s="$1"
  echo "${s//[@:.\/]/-}"
}

# Validates and canonicalizes a numeric session-ID string into its
# base-10 form. Shared by every place a raw digit string needs to become
# a real, arithmetic-safe ID -- next_session_id (the counter file),
# parse_kill_spec (--kill's argument), parse_numbered_session (live tmux
# names and registry entries), and find_or_assign_id (reused registry
# IDs) -- so all of them reject/canonicalize the exact same way instead
# of each reimplementing this with slightly different edge cases.
# Capped at 15 digits: bash integers are signed 64-bit (~19 digits), and
# no real ID is anywhere close to that many, so this keeps a
# pathological value (a 21-digit live tmux name, a poisoned registry
# entry, a corrupted counter file) out of `printf %d`/`(( ))` arithmetic
# entirely rather than letting it crash or silently wrap negative there
# (confirmed live: "08: invalid octal number" from printf, "Result too
# large" from a 21-digit value, a 44-digit value wrapping to a large
# negative number in arithmetic). A leading-zero numeral (e.g. "08") is
# also otherwise treated by bash arithmetic as octal -- "08"/"09" are a
# hard crash (8/9 aren't valid octal digits) and "010" silently means 8
# in decimal -- so the explicit `10#` base prefix forces plain base-10
# reading instead, canonicalizing away the leading zero too. 0 itself is
# rejected: next_session_id never assigns it. Prints the canonical value
# on stdout and returns 0 if valid; prints nothing and returns 1
# otherwise.
canonicalize_session_id() {
  local raw="$1"
  [[ "$raw" =~ ^[0-9]{1,15}$ ]] || return 1
  local canon=$((10#$raw))
  ((canon == 0)) && return 1
  printf '%s' "$canon"
}

# Returns the next session ID and persists the increment to
# ~/.config/codersync/next_id. Global (not per-target) so IDs stay
# unique across boxes even if you switch --setup targets later -- with
# per-target counters, --list-all/--kill would have to disambiguate
# "ID 1 on box A" from "ID 1 on box B" instead of just "ID 1".
next_session_id() {
  local id raw
  if [[ -f "$NEXT_ID_FILE" ]]; then
    raw="$(cat "$NEXT_ID_FILE")"
    # A non-numeric, negative, zero, leading-zero, or pathologically long
    # value here (hand-edited, truncated by a crash mid-write, whatever)
    # used to either crash outright or silently produce a wrong/negative
    # ID -- see canonicalize_session_id's comment for the specifics.
    # Resetting with a clear warning is safer than guessing at intent.
    if ! id="$(canonicalize_session_id "$raw")"; then
      echo "codersync: ${NEXT_ID_FILE} contained an invalid value ('${raw}') -- resetting the session-ID counter to 1." >&2
      id=1
    fi
  else
    id=1
  fi
  mkdir -p "$CONFIG_DIR"
  echo "$((id + 1))" > "$NEXT_ID_FILE"
  echo "$id"
}

# Ensures the persisted next_id counter is at least one past `id`, so a
# future next_session_id() call can never re-mint an ID that
# adopt_sessions just preserved from a live, already-numbered session
# -- one that exists independently of this client's own counter
# (created on a different client machine's registry, or hand-created).
# Without this, adopting e.g. "pair-1-host-foo" while this client's own
# counter was still at its default of 1 left the very next
# `codersync <name>` invocation minting ID 1 again -- two different
# registry entries for the same target both claiming ID 1, which
# --list-all then shows as a duplicate and --kill 1 matches both
# (confirmed live/reproduced with a stub). A no-op if the counter is
# already past `id`.
bump_next_id_past() {
  local id="$1"
  mkdir -p "$CONFIG_DIR"
  local current canon
  if [[ -f "$NEXT_ID_FILE" ]]; then
    current="$(cat "$NEXT_ID_FILE")"
    if ! canon="$(canonicalize_session_id "$current")"; then
      canon=1
    fi
  else
    canon=1
  fi
  if (( id + 1 > canon )); then
    echo "$((id + 1))" > "$NEXT_ID_FILE"
  fi
}

# Parses a live tmux session name like "claude-<id>-<rest>" into
# PARSED_ID/PARSED_REST globals. `prefix` is "claude-", "codex-", or
# "pair-" (pass "" to parse a bare registry entry name, which has no
# agent prefix). Sessions created before numbering existed have no
# numeric leading segment -- PARSED_ID is left empty in that case (not
# "0" or some other sentinel) so callers can cleanly test for its
# absence. An ID-shaped-but-INVALID segment (fails
# canonicalize_session_id -- too many digits, or literally "0"/"000")
# is treated the same as "no ID" rather than crashing downstream: a live
# session or registry entry with a broken ID segment used to reach
# printf/arithmetic as-is and crash there instead (confirmed live:
# "pair-08-host-foo" and a 21-digit ID). PARSED_ID is always the
# canonical decimal form (no leading zeros) when present.
parse_numbered_session() {
  local prefix="$1"
  local full="$2"
  local rest="${full#"$prefix"}"
  local canon
  if [[ "$rest" =~ ^([0-9]+)-(.*)$ ]] && canon="$(canonicalize_session_id "${BASH_REMATCH[1]}")"; then
    PARSED_ID="$canon"
    PARSED_REST="${BASH_REMATCH[2]}"
  else
    PARSED_ID=""
    PARSED_REST="$rest"
  fi
}

# Parses one registry line into ENTRY_TARGET/ENTRY_NAME globals. Lines
# from before the per-target format existed are bare names with no tab
# -- treated as belonging to the current target (a one-time migration
# assumption; see register_session()/restore_all() below). Pulled out
# as its own function so it's unit-testable in isolation.
parse_registry_line() {
  local line="$1"
  if [[ "$line" == *$'\t'* ]]; then
    ENTRY_TARGET="${line%%$'\t'*}"
    ENTRY_NAME="${line#*$'\t'}"
  else
    ENTRY_TARGET="$SSH_TARGET"
    ENTRY_NAME="$line"
  fi
}

# Reuses the EXISTING registry entry's raw text for this exact
# target+raw-name combination if EXACTLY ONE exists, otherwise
# allocates a fresh id and returns "${new_id}-${suffix}". Returns the
# FULL raw session name, not just a bare id -- returning just the
# canonical id (as this function used to) and letting the caller
# reconstruct "${id}-${suffix}" itself discarded any leading zero (or
# other raw formatting) an already-existing entry had: a registry
# entry "08-devbox-example-com-foo" canonicalizes to id=8, but
# reconstructing "8-devbox-example-com-foo" from that is a DIFFERENT
# raw string than what's already registered and already live -- so
# re-running `codersync foo` against a session already reachable this
# way (e.g. after `--adopt` picked up a leading-zero live session)
# created a SECOND, differently-spelled session and registry entry
# instead of reattaching to the existing one, breaking the exact
# idempotence this function exists to guarantee (confirmed live). Same
# bug shape resolve_registered_session/rename_session/adopt_sessions
# already avoid for their own lookups, by preserving raw text instead
# of reconstructing it from canonical parts.
#
# If MORE than one valid entry matches this suffix, errors instead of
# silently picking whichever one happened to appear first in the file
# -- a leftover pair of entries from the PRIOR version of this exact
# bug (e.g. both "8-devbox-example-com-foo" and
# "08-devbox-example-com-foo" registered for the same suffix, only one
# of them actually still live) would otherwise have this function
# blindly return the FIRST one on disk regardless of which is real,
# same issue reported for resolve_registered_session's own ID lookup.
# `--restore-all` already resolves this on its own the next time it
# runs (it checks each entry's OWN liveness independently and prunes
# whichever isn't), so this points there rather than trying to also
# guess correctly here.
find_or_assign_id() {
  local target="$1" suffix="$2"
  touch "$REGISTRY"
  local line
  local -a id_suffix_matches=()
  local seen=$'\n'
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    parse_registry_line "$line"
    [[ "$ENTRY_TARGET" != "$target" ]] && continue
    if [[ "$ENTRY_NAME" =~ ^([0-9]+)-(.*)$ ]] && [[ "${BASH_REMATCH[2]}" == "$suffix" ]]; then
      # A poisoned/corrupted entry (e.g. "08-...", "0-...", or a
      # pathologically long ID) is never reused -- next_session_id
      # itself would reject that exact value, so blindly returning it
      # here would let it right back out as a real session ID.
      if canonicalize_session_id "${BASH_REMATCH[1]}" >/dev/null; then
        # Exact duplicate LINES (identical target+name, e.g. from a
        # stale double-write before this check existed) are collapsed
        # to a single candidate here -- without this, two identical
        # entries counted as "2 matches", wrongly triggering the
        # ambiguity error below even though there's really only one
        # distinct session in play (confirmed live: --restore-all
        # doesn't actually resolve this particular shape either, since
        # it independently restores each duplicate LINE, leaving both
        # intact -- see restore_all's own de-dup fix for that).
        case "$seen" in
          *$'\n'"$ENTRY_NAME"$'\n'*) ;;
          *) seen+="$ENTRY_NAME"$'\n'; id_suffix_matches+=("$ENTRY_NAME") ;;
        esac
      fi
    fi
  done < "$REGISTRY"
  if [[ ${#id_suffix_matches[@]} -gt 1 ]]; then
    echo "codersync: multiple registry entries match '${suffix}' on ${target}: ${id_suffix_matches[*]} -- can't tell which is the real one. Run codersync --restore-all to prune whichever isn't actually alive, then try again." >&2
    exit 1
  fi
  if [[ ${#id_suffix_matches[@]} -eq 1 ]]; then
    echo "${id_suffix_matches[0]}"
    return 0
  fi
  echo "$(next_session_id)-${suffix}"
}

# Strips one matching pair of surrounding single quotes, if present.
# Before %q-quoting was introduced, setup() wrote config values wrapped
# in a literal, hardcoded pair of single quotes (`SSH_TARGET='devbox.example.com'`)
# regardless of content. The current format never wraps a value that
# already passes validation, so stripping this unconditionally is safe
# either way -- it's a no-op for anything written by the current
# setup(), and lets a config from before this parser existed keep
# working without forcing --setup again.
strip_legacy_config_quotes() {
  local v="$1"
  if [[ "$v" == \'*\' && "${#v}" -ge 2 ]]; then
    v="${v:1:${#v}-2}"
  fi
  printf '%s' "$v"
}

load_config() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "codersync isn't set up yet. Run: codersync --setup <ssh-target> [remote-dir]" >&2
    exit 1
  fi
  # Deliberately NOT `source`d. setup() validates before writing, but the
  # file on disk isn't necessarily what setup() wrote -- it could be
  # hand-edited, or left over from a version of this script that wrote it
  # without validation at all. `source` runs the file as a bash script,
  # so ANY line in it executes immediately, before there's any value to
  # even check -- confirmed live, a config containing a line like
  # `touch /some/file` created that file even though the SSH_TARGET check
  # right after correctly rejected the resulting (empty) value. Reading
  # the file with plain `read`/regex instead never executes its content
  # at all, so a malicious line just fails to match either expected key
  # and gets rejected outright instead of running.
  local raw_target="" raw_dir="" saw_target=0 saw_dir=0 line
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    if [[ "$line" =~ ^SSH_TARGET=(.*)$ ]]; then
      raw_target="${BASH_REMATCH[1]}"
      saw_target=1
    elif [[ "$line" =~ ^REMOTE_DIR=(.*)$ ]]; then
      raw_dir="${BASH_REMATCH[1]}"
      saw_dir=1
    else
      echo "Config at $CONFIG_FILE has an unrecognized line: '${line}'. Re-run: codersync --setup <ssh-target> [remote-dir]" >&2
      exit 1
    fi
  done < "$CONFIG_FILE"

  if [[ "$saw_target" != 1 || -z "$raw_target" ]]; then
    echo "Config at $CONFIG_FILE is incomplete. Re-run: codersync --setup <ssh-target> [remote-dir]" >&2
    exit 1
  fi
  SSH_TARGET="$(strip_legacy_config_quotes "$raw_target")"
  if ! validate_ssh_target "$SSH_TARGET"; then
    echo "Config at $CONFIG_FILE has an invalid SSH_TARGET ('${SSH_TARGET}'). Re-run: codersync --setup <ssh-target> [remote-dir]" >&2
    exit 1
  fi

  if [[ "$saw_dir" == 1 && -n "$raw_dir" ]]; then
    # setup() writes this value via `printf '%q'`, which backslash-
    # escapes a leading `~` specifically so a naive `source` wouldn't
    # tilde-expand it against THIS machine's home dir. This parser never
    # sources the file, so that protection isn't needed here -- strip the
    # one leading backslash %q would have added, to recover the literal
    # value (still containing a real `~`, which remote_setup's heredocs
    # rely on the REMOTE shell to tilde-expand correctly). Legacy-quote
    # stripping happens first since an old-format value was never
    # backslash-escaped in the first place -- only wrapped in quotes.
    raw_dir="$(strip_legacy_config_quotes "$raw_dir")"
    REMOTE_DIR="${raw_dir#\\}"
  else
    # shellcheck disable=SC2088 # intentional: literal `~`, expanded
    # later by the REMOTE shell, not by this one.
    REMOTE_DIR="~/repos"
  fi
  if ! validate_remote_dir "$REMOTE_DIR"; then
    echo "Config at $CONFIG_FILE has an invalid REMOTE_DIR ('${REMOTE_DIR}'). Re-run: codersync --setup <ssh-target> [remote-dir]" >&2
    exit 1
  fi
  TARGET_LABEL="$(sanitize_label "$SSH_TARGET")"
}

# Resolves a short tool key to its launch command, auto-appending that
# tool's "skip approval" flag -- unless safe="1", in which case the known
# key's base command is used with no auto-approve flag at all, so normal
# permission prompts apply. Anything that doesn't match a known key is
# treated as a literal command to run as-is regardless of safe -- so any
# CLI agent works, not just the ones with a short name below (e.g.
# `--tools claude,zai` where `zai` is whatever exact command the user
# already knows is correct for their tool; safe mode has no way to know
# how to strip a flag from an arbitrary command, so it's on the user to
# just not include one). Known-key flags are sourced and verified, not
# guessed -- see the comment above each one.
resolve_tool() {
  local key="$1"
  local session="$2"
  local safe="${3:-0}"
  local base flag
  case "$key" in
    claude) base="claude -n ${session}"; flag="--dangerously-skip-permissions" ;;
    codex)  base="codex";                flag="--dangerously-bypass-approvals-and-sandbox -s danger-full-access" ;;
    # Gemini CLI was shut down 2026-06-18 and replaced by Antigravity CLI
    # (binary name `agy`, not `gemini`). No --yolo equivalent exists for
    # agy -- --dangerously-skip-permissions is the official replacement.
    # https://developers.googleblog.com/an-important-update-transitioning-gemini-cli-to-antigravity-cli/
    agy)    base="agy";                  flag="--dangerously-skip-permissions" ;;
    # https://aider.chat/docs/scripting.html
    aider)  base="aider";                flag="--yes-always" ;;
    # https://www.codeagentswarm.com/en/guides/kimi-code-yolo-mode
    kimi)   base="kimi";                 flag="--yolo" ;;
    *)      echo "$key"; return ;;
  esac
  if [[ "$safe" == "1" ]]; then
    echo "$base"
  else
    echo "$base $flag"
  fi
}

# Returns (on stdout) the actual executable name from a resolved
# command string, skipping any leading NAME=value environment-
# assignment words -- e.g. "OPENAI_API_KEY=sk-... some-agent --flag"
# becomes "some-agent", not "OPENAI_API_KEY=sk-...". A raw --tools
# value is documented as the exact command to run, and `VAR=value cmd`
# is an ordinary, valid way to write that under bash -- but a flat
# "${cmd%% *}" split (the previous behavior here) took the assignment
# itself as the thing to existence-check remotely, so setup/launch
# reported a perfectly runnable command as "not found" (confirmed
# live). Uses a plain space-split loop rather than `for word in $cmd`
# specifically to avoid unquoted `$cmd` undergoing local pathname
# (glob) expansion -- a literal --tools value could otherwise contain
# characters that match files in whatever directory this happens to
# run from.
#
# Known, deliberate limitation: only a plain, unquoted value is
# recognized -- `FOO='bar baz' some-agent` or `FOO=bar\ baz some-agent`
# (both valid bash, an assignment whose VALUE contains a literal space)
# still split apart mid-value and get misread the same way the bug
# above did, just for a narrower reason. Fixing that fully would mean
# actually parsing the string as shell syntax (quote/escape removal),
# and the only way to do that in bash is to have bash itself evaluate
# it (`eval`/`set --`) -- which would also execute any `$(...)`/
# backtick command substitution embedded in the value, immediately and
# LOCALLY, merely to figure out what to existence-check. That's a
# categorically different and worse risk than the narrow parsing gap
# it would close (this string is otherwise only ever shipped to the
# remote box as inert data, never locally evaluated), so it's not worth
# it for this edge case. README's Supported tools section documents
# the `env NAME=value cmd` workaround for anyone who hits this.
command_word_for() {
  local cmd="$1"
  local word
  while :; do
    word="${cmd%% *}"
    if [[ "$word" =~ ^[A-Za-z_][A-Za-z0-9_]*=.*$ ]] && [[ "$cmd" == *" "* ]]; then
      cmd="${cmd#* }"
      continue
    fi
    printf '%s' "$word"
    return 0
  done
}

# Escapes backslash and double-quote for embedding a string as a literal
# inside a "..." double-quoted context (used for the AppleScript "..."
# strings in open_tab/open_tab_tmux_mode below).
as_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

# Base64-encodes a string for embedding anywhere without quoting concerns
# -- base64 output is only [A-Za-z0-9+/=], none of which are shell-special
# in any of the nested contexts these launch commands pass through
# (local heredoc -> remote bash -> tmux hook value -> run-shell ->
# /bin/sh -> tmux send-keys). Used for --tools commands specifically
# because a raw command containing its own quotes (e.g. `bash -c "echo
# hi"`) collided with the wrapper quotes at one of those layers no matter
# how it was escaped -- confirmed live, tmux mis-parsed it every time.
# Writing the resolved command to a remote file and having send-keys
# invoke that file (a plain, quote-free path) sidesteps the problem
# entirely instead of trying to out-escape it.
#
# `tr -d '\n'` strips whatever line-wrapping the LOCAL `base64` decides
# to apply -- every call site embeds this output directly into a remote
# heredoc as one bare token (e.g. `echo ${cmd1_b64} | base64 -d`), which
# requires it to stay on one line. macOS's own BSD `base64` doesn't wrap
# by default, but a GNU coreutils `base64` earlier in PATH (a common
# Homebrew setup) wraps at 76 characters -- a long enough resolved
# command (a long session name, a long literal --tools value) would
# otherwise split across multiple `echo` arguments/lines in the
# generated remote script and fail to decode correctly. Stripping
# newlines here makes the encoded form unwrapped regardless of which
# `base64` produced it; the DECODED value is unaffected either way,
# since base64 decoding already ignores embedded whitespace by
# convention.
b64() { printf '%s' "$1" | base64 | tr -d '\n'; }

# A short random alphanumeric string for use in a remote temp-file name.
# Deterministic /tmp paths are a real risk on a shared/multi-user remote
# box: another user could pre-create a symlink at a guessable path
# pointing at a file we don't intend to touch, and our `>` redirect
# would follow it. Randomizing the path each run makes that
# infeasible to pre-plant; `set -C` (noclobber) in the heredocs that
# write these files is the second layer -- it makes the write fail
# outright rather than follow a symlink if something's already there.
random_suffix() {
  if [[ -r /dev/urandom ]]; then
    head -c 16 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 12
  else
    printf '%s' "${RANDOM}${RANDOM}${RANDOM}"
  fi
}

# Expands a --kill spec like "1,2,4" or "1-4" (or a mix, "1,3-5,8") into
# a sorted, de-duplicated list of IDs, one per line. Pure parsing, no
# I/O -- kill_sessions() below does the actual remote work. Pulled out
# as its own function so it's unit-testable in isolation.
#
# Collects into a plain (possibly duplicate-containing) array and lets
# `sort -n -u` handle both sorting and de-duplication at the end, rather
# than an associative array -- macOS ships bash 3.2 as `/bin/bash`
# (frozen there for licensing reasons; `env bash` resolves to it unless
# a newer bash is installed AND earlier in PATH), and 3.2 doesn't support
# `local -A`/`declare -A` at all. `sort -u`'s de-dup is unambiguous here
# since every element is a single bare number with no other trailing
# fields on the line for it to disagree with.
parse_kill_spec() {
  local spec="$1"
  local -a ids=()
  local token start end i canon_id
  # A single codersync session is created by hand, one at a time -- a
  # range spanning more than this many IDs is almost certainly a typo
  # (e.g. an extra digit turning "1-4" into "1-999999999"), not a real
  # request, and expanding it anyway would build a huge in-memory array
  # before any remote work even starts. The {1,15}-digit cap on both
  # regexes below is a second, independent guard: it keeps a pathological
  # value (way more digits than any real ID) out of the `(( ))` arithmetic
  # entirely, rather than letting bash's own integer-overflow error crash
  # the script uncaught.
  local max_range_size=1000
  IFS=',' read -ra tokens <<<"$spec"
  for token in "${tokens[@]}"; do
    if [[ "$token" =~ ^([0-9]{1,15})-([0-9]{1,15})$ ]]; then
      # canonicalize_session_id rejects 0 and normalizes away a
      # leading-zero numeral (e.g. "08") -- see its own comment for why.
      # At this point in the range case, its only possible failure is a
      # 0 boundary (the {1,15}-digit regex above already rules out the
      # overflow case), so one message covers both start/end failing.
      start="$(canonicalize_session_id "${BASH_REMATCH[1]}")" || start=""
      end="$(canonicalize_session_id "${BASH_REMATCH[2]}")" || end=""
      if [[ -z "$start" || -z "$end" ]]; then
        echo "Invalid range '$token': IDs start at 1, 0 is never assigned" >&2
        return 1
      fi
      if ((start > end)); then
        echo "Invalid range '$token': start must be <= end" >&2
        return 1
      fi
      if ((end - start + 1 > max_range_size)); then
        echo "Invalid range '$token': spans more than ${max_range_size} IDs -- did you mean something narrower?" >&2
        return 1
      fi
      for ((i = start; i <= end; i++)); do
        ids+=("$i")
      done
    elif [[ "$token" =~ ^[0-9]{1,15}$ ]]; then
      if ! canon_id="$(canonicalize_session_id "$token")"; then
        echo "Invalid --kill token: '$token' -- IDs start at 1, 0 is never assigned" >&2
        return 1
      fi
      ids+=("$canon_id")
    else
      echo "Invalid --kill token: '$token' (expected a number or a range like 1-4)" >&2
      return 1
    fi
  done
  printf '%s\n' "${ids[@]}" | sort -n -u
}

# True if iTerm2 is actually installed/controllable via AppleScript.
# `--split-mode tmux`'s whole point is not depending on iTerm2 (the
# split lives server-side in tmux; the local side only opens a tab and
# attaches once) -- but until there's a non-macOS/non-iTerm2 way to
# actually open that tab, this still shells out to iTerm2 when it's
# available and falls back to printing the attach command otherwise, so
# the tool at least degrades gracefully instead of just failing.
iterm2_available() {
  command -v osascript >/dev/null 2>&1 || return 1
  [[ "$(osascript -e 'exists application "iTerm2"' 2>/dev/null)" == "true" ]] || return 1
  # `exists application` alone doesn't prove osascript can actually
  # CONTROL iTerm2 -- that's a Finder-level lookup, not an Apple Event
  # sent to iTerm2 itself, so it still reports true even with
  # Automation permission denied. `count windows` is a real (if
  # harmless -- no window is created or changed) Apple Event; it fails
  # if that permission is missing, which is exactly the other half of
  # what open_tab()/open_tab_tmux_mode() need to actually work later.
  osascript -e 'tell application "iTerm2" to count windows' >/dev/null 2>&1
}

# Create both detached tmux sessions on the remote box. Idempotent: if a
# session already exists, `tmux new-session` fails for that line (`&&`
# short-circuits so we don't re-arm the hook on top of a running tool)
# and we just fall through to attaching to whatever is already running.
#
# "claude"/"codex" in the session names below are positional slot names
# (left pane, right pane), not necessarily what's actually running there
# -- e.g. `--tools agy,aider` still uses claude-<session>/codex-<session>
# as the tmux session names, just running agy/aider inside them. Kept
# this way so restore_all's detection logic doesn't need to change.
#
# The hook's action runs via `run-shell`, which hands the string to a real
# /bin/sh -- a plain `;` there is an ordinary shell statement separator,
# not tmux's own (much trickier, nesting-depth-sensitive) command-chaining
# syntax.
#
# tmux's status bar is turned off for both sessions: it isn't used for
# anything here, and its bottom row is a second thing (besides the app
# itself) that has to survive a resize cleanly.
#
# `umask 077` before writing the launch scripts: without it, they inherit
# the remote user's default umask (commonly 022), which makes a resolved
# --tools command containing its own secret (an API token as a raw
# literal command, say) world-readable in /tmp until cleaned up. Random
# filenames + `set -C` stop another user from planting/clobbering the
# file, but neither stops one from just reading it once it exists.
#
# There was also no cleanup path at all before this: nothing ever removed
# these files, so a secret in a --tools command persisted in /tmp
# indefinitely. Each script's own first line is now `rm -f -- "$0"` --
# self-deleting the instant the pane actually runs it (`bash <script>`
# keeps a valid read on the already-open file even after its directory
# entry is unlinked, so this doesn't affect the real command that
# follows on the next line). This narrows the window during which the
# file is on disk at all to "between creation and the pane's first
# attach" -- sessions are created idle and don't run their launch script
# until a client actually attaches (see below), so that gap can still be
# arbitrarily long if nobody attaches right away; there's no way to
# delete a file before something has read it.
#
# `tmux new-session -c ${REMOTE_DIR}` runs BEFORE writing the script,
# not after -- so the session already exists (and is killable, to clean
# up any script via remote_kill_session's glob) before anything that
# could still fail runs. (`-c` on a bad/inaccessible directory doesn't
# actually make `tmux new-session` itself fail, in practice -- it just
# silently falls back to a default directory instead -- so this ordering
# is defense-in-depth for OTHER failures after creation, not that
# specific one.)
#
# Each session's whole setup (from `new-session` through the hook) is
# also wrapped in its own remote `trap ... EXIT`, armed right after
# creation and disarmed right before the block's last command. Without
# it, ANY failure in between -- `set -C` colliding with a pre-existing
# path, a decode error, `tmux set-hook` itself failing -- left a live,
# fully-registered session that was idle and never going to run
# anything: future invocations see `has-session` succeed and skip setup
# entirely, so the agent silently never launches, with no error shown
# on the failed run OR any later one (confirmed live by forcing
# `set-hook` to fail after a real `new-session`). The trap kills that
# same session and removes its script(s) so the failure is visible
# immediately and a retry starts clean instead of silently limping along
# with half a setup. It's scoped to ONE session at a time (not the whole
# script) deliberately: if creating one side of an iterm-split pair
# fails after the other already succeeded, only the failed one should
# roll back -- the other is already correctly set up and shouldn't be
# torn down just to keep the operation "atomic".
remote_setup() {
  local session="$1"
  local tool1="${2:-claude}"
  local tool2="${3:-codex}"
  local safe="${4:-0}"
  local claude_tmux="claude-${session}"
  local codex_tmux="codex-${session}"
  local cmd1 cmd2 bin1 bin2 cmd1_b64 cmd2_b64 bin1_b64 bin2_b64 script1 script2
  cmd1="$(resolve_tool "$tool1" "$session" "$safe")"
  cmd2="$(resolve_tool "$tool2" "$session" "$safe")"
  bin1="$(command_word_for "$cmd1")"
  bin2="$(command_word_for "$cmd2")"
  cmd1_b64="$(b64 "$cmd1")"
  cmd2_b64="$(b64 "$cmd2")"
  # bin1/bin2 are base64'd too, not interpolated as raw text like the
  # rest of this function's b64 comment describes -- a raw --tools value
  # with a shell metacharacter (confirmed live with a $IFS-based payload)
  # otherwise gets interpreted by the remote shell right here, in the
  # existence-check line itself, before the actual b64-decoded launch
  # script is even written. Decoding into a remote variable and using it
  # quoted ("$bin1") closes that off regardless of what bin1 contains.
  bin1_b64="$(b64 "$bin1")"
  bin2_b64="$(b64 "$bin2")"
  script1="/tmp/codersync-${claude_tmux}-$(random_suffix).sh"
  script2="/tmp/codersync-${codex_tmux}-$(random_suffix).sh"
  # Tool existence is checked remotely, but ONLY for whichever session(s)
  # actually need creating (guarded by `has-session`) -- not on every
  # call. restore_all always passes placeholder "claude"/"codex"
  # regardless of what a session was originally started with (it
  # doesn't track that), so checking unconditionally would wrongly block
  # restoring an already-running session over an irrelevant "claude not
  # found" when the box only has e.g. agy/aider installed. Without this
  # check at all, a missing tool failed completely silently on fresh
  # creation -- the local script exited 0 with no output, and the only
  # trace was a "command not found" line inside the pane itself
  # (confirmed live).
  #
  # BOTH tools are checked before creating EITHER session, not tool1
  # checked/created then tool2 checked/created -- otherwise, tool1
  # existing and tool2 missing left claude_tmux fully created (session +
  # launcher file + hook) with codex_tmux never created at all, and no
  # easy way to tell that half-created state apart from a deliberate
  # single-session request (confirmed live). remote_setup_tmux_mode
  # never had this problem since it's one session either fully created
  # or not at all; this preflights both checks up front to match that.
  # shellcheck disable=SC2087 # intentional: local expansion is the point --
  # ${claude_tmux}/${bin1_b64}/etc. below are THIS script's variables and
  # must substitute before the heredoc is sent; only the \$-escaped ones
  # are meant to survive as literal text for the remote shell to evaluate.
  # `export PATH=...` here for the same reason as the tmux/bash checks
  # in setup(): a non-interactive `ssh ... bash -s` doesn't source
  # ~/.bashrc/~/.profile, so a tool only on PATH because one of those
  # adds it (e.g. ~/.local/bin, where pipx/pip --user/etc. install)
  # reports as missing here even though it runs fine in a real
  # interactive session (confirmed live: claude/codex under
  # ~/.local/bin). This is the existence check itself, not the actual
  # launch below -- the launch runs inside a real tmux pane's own
  # interactive shell, which sources those files normally.
  if ! ssh "$SSH_TARGET" -- 'PATH="$HOME/.local/bin:$HOME/bin:$PATH" bash -s' <<EOF
set -e
set -C
umask 077
export PATH="\$HOME/.local/bin:\$HOME/bin:\$PATH"
bin1=\$(echo ${bin1_b64} | base64 -d)
bin2=\$(echo ${bin2_b64} | base64 -d)
need_claude=0
need_codex=0
tmux has-session -t ${claude_tmux} 2>/dev/null || need_claude=1
tmux has-session -t ${codex_tmux} 2>/dev/null || need_codex=1
missing=""
if [ "\$need_claude" = 1 ]; then
  command -v "\$bin1" >/dev/null 2>&1 || missing="\${missing} \$bin1"
fi
if [ "\$need_codex" = 1 ]; then
  command -v "\$bin2" >/dev/null 2>&1 || missing="\${missing} \$bin2"
fi
if [ -n "\${missing}" ]; then
  echo "codersync: not found on \$(hostname):\${missing}" >&2
  exit 1
fi
if [ "\$need_claude" = 1 ]; then
  tmux new-session -d -s ${claude_tmux} -c ${REMOTE_DIR}
  trap 'tmux kill-session -t ${claude_tmux} 2>/dev/null; rm -f -- ${script1}' EXIT
  echo 'rm -f -- "\$0"' > ${script1}
  echo ${cmd1_b64} | base64 -d >> ${script1}
  tmux set-hook -t ${claude_tmux} client-attached "run-shell 'tmux send-keys -t ${claude_tmux} \"bash ${script1}\" Enter; tmux set-hook -u -t ${claude_tmux} client-attached'"
  tmux set-option -t ${claude_tmux} status off
  trap - EXIT
fi
if [ "\$need_codex" = 1 ]; then
  tmux new-session -d -s ${codex_tmux} -c ${REMOTE_DIR}
  trap 'tmux kill-session -t ${codex_tmux} 2>/dev/null; rm -f -- ${script2}' EXIT
  echo 'rm -f -- "\$0"' > ${script2}
  echo ${cmd2_b64} | base64 -d >> ${script2}
  tmux set-hook -t ${codex_tmux} client-attached "run-shell 'tmux send-keys -t ${codex_tmux} \"bash ${script2}\" Enter; tmux set-hook -u -t ${codex_tmux} client-attached'"
  tmux set-option -t ${codex_tmux} status off
  trap - EXIT
fi
EOF
  then
    echo "codersync: aborting '${session}' -- see the error above." >&2
    exit 1
  fi
}

# Opens a new iTerm2 tab, splits it vertically (left/right), titles and
# attaches each pane. claude on the left, codex on the right.
open_tab() {
  local session="$1"
  local claude_tmux="claude-${session}"
  local codex_tmux="codex-${session}"

  local title_cmd="printf '\033]0;${session}\007'"
  # shellcheck disable=SC2016 # intentional: $(date...) stays literal here
  # so it's evaluated fresh by the shell that runs this loop on each
  # retry, not frozen to the timestamp when this string was built.
  local claude_attach='while true; do ssh -t '"${SSH_TARGET}"' -- tmux attach -t '"${claude_tmux}"'; echo "[$(date +%H:%M:%S)] disconnected, retrying in 2s..."; sleep 2; done'
  # shellcheck disable=SC2016 # intentional -- same as claude_attach above.
  local codex_attach='while true; do ssh -t '"${SSH_TARGET}"' -- tmux attach -t '"${codex_tmux}"'; echo "[$(date +%H:%M:%S)] disconnected, retrying in 2s..."; sleep 2; done'

  local title_esc claude_esc codex_esc
  title_esc="$(as_escape "$title_cmd")"
  claude_esc="$(as_escape "$claude_attach")"
  codex_esc="$(as_escape "$codex_attach")"

  osascript <<APPLESCRIPT
tell application "iTerm2"
  activate
  if (count of windows) = 0 then
    create window with default profile
  end if
  tell current window
    set newTab to (create tab with default profile)
    tell newTab
      tell current session
        write text "${title_esc}"
        write text "${claude_esc}"
        set rightSession to (split vertically with default profile)
      end tell
    end tell
  end tell
  tell rightSession
    write text "${title_esc}"
    write text "${codex_esc}"
  end tell
end tell
APPLESCRIPT
}

# --split-mode tmux: create ONE tmux session with two panes split
# server-side, instead of two separate sessions. Same idle-until-attached
# + client-attached-hook approach as remote_setup, just targeting pane 0
# and pane 1 of one session instead of two sessions -- still avoids the
# resize-during-startup rendering bug. Also uses `umask 077` before
# writing the launch scripts, and the same remote `trap ... EXIT`
# rollback-on-failure approach -- see the comments above remote_setup()
# for both. Only one trap/session here (not one per side), since this
# mode is already all-or-nothing: a single session with two panes,
# never two independent sessions to partially succeed between.
remote_setup_tmux_mode() {
  local session="$1"
  local tool1="${2:-claude}"
  local tool2="${3:-codex}"
  local safe="${4:-0}"
  local pair_tmux="pair-${session}"
  local cmd1 cmd2 bin1 bin2 cmd1_b64 cmd2_b64 bin1_b64 bin2_b64 script1 script2
  cmd1="$(resolve_tool "$tool1" "$session" "$safe")"
  cmd2="$(resolve_tool "$tool2" "$session" "$safe")"
  bin1="$(command_word_for "$cmd1")"
  bin2="$(command_word_for "$cmd2")"
  cmd1_b64="$(b64 "$cmd1")"
  cmd2_b64="$(b64 "$cmd2")"
  # bin1/bin2 are base64'd too -- see the comment in remote_setup() above
  # for why (a raw --tools value with a shell metacharacter otherwise
  # gets interpreted by the remote shell in the existence-check line
  # itself; confirmed live with a $IFS-based payload).
  bin1_b64="$(b64 "$bin1")"
  bin2_b64="$(b64 "$bin2")"
  script1="/tmp/codersync-${pair_tmux}-0-$(random_suffix).sh"
  script2="/tmp/codersync-${pair_tmux}-1-$(random_suffix).sh"
  # Tool existence is checked remotely, but ONLY when actually about to
  # create the session (guarded by `has-session`), not on every call --
  # see the comment in remote_setup() for why (restore_all always passes
  # placeholder tool names, which would wrongly block restoring an
  # already-running session over an irrelevant missing-tool check).
  # Without this check at all, a missing tool failed completely silently
  # on fresh creation (confirmed live).
  # shellcheck disable=SC2087 # intentional -- see remote_setup() above.
  if ! ssh "$SSH_TARGET" -- 'PATH="$HOME/.local/bin:$HOME/bin:$PATH" bash -s' <<EOF
set -e
set -C
umask 077
export PATH="\$HOME/.local/bin:\$HOME/bin:\$PATH"
bin1=\$(echo ${bin1_b64} | base64 -d)
bin2=\$(echo ${bin2_b64} | base64 -d)
if ! tmux has-session -t ${pair_tmux} 2>/dev/null; then
  missing=""
  command -v "\$bin1" >/dev/null 2>&1 || missing="\${missing} \$bin1"
  command -v "\$bin2" >/dev/null 2>&1 || missing="\${missing} \$bin2"
  if [ -n "\${missing}" ]; then
    echo "codersync: not found on \$(hostname):\${missing}" >&2
    exit 1
  fi
  tmux new-session -d -s ${pair_tmux} -c ${REMOTE_DIR}
  trap 'tmux kill-session -t ${pair_tmux} 2>/dev/null; rm -f -- ${script1} ${script2}' EXIT
  tmux split-window -h -t ${pair_tmux} -c ${REMOTE_DIR}
  echo 'rm -f -- "\$0"' > ${script1}
  echo ${cmd1_b64} | base64 -d >> ${script1}
  echo 'rm -f -- "\$0"' > ${script2}
  echo ${cmd2_b64} | base64 -d >> ${script2}
  tmux set-hook -t ${pair_tmux} client-attached "run-shell 'tmux send-keys -t ${pair_tmux}.0 \"bash ${script1}\" Enter; tmux send-keys -t ${pair_tmux}.1 \"bash ${script2}\" Enter; tmux set-hook -u -t ${pair_tmux} client-attached'"
  tmux set-option -t ${pair_tmux} status off
  trap - EXIT
fi
EOF
  then
    echo "codersync: aborting '${session}' -- see the error above." >&2
    exit 1
  fi
}

# --split-mode tmux: open a tab and run ONE attach command -- the split
# already exists server-side, so there's nothing to split locally. Falls
# back to printing the attach command when iTerm2 isn't available, since
# this mode's whole point is not depending on it (see iterm2_available()).
open_tab_tmux_mode() {
  local session="$1"
  local pair_tmux="pair-${session}"

  # shellcheck disable=SC2016 # intentional -- see open_tab() above.
  local attach='while true; do ssh -t '"${SSH_TARGET}"' -- tmux attach -t '"${pair_tmux}"'; echo "[$(date +%H:%M:%S)] disconnected, retrying in 2s..."; sleep 2; done'

  if ! iterm2_available; then
    echo "iTerm2 not found -- open a new tab/terminal yourself and run:"
    echo "  $attach"
    return 0
  fi

  local title_cmd="printf '\033]0;${session}\007'"
  local title_esc attach_esc
  title_esc="$(as_escape "$title_cmd")"
  attach_esc="$(as_escape "$attach")"

  osascript <<APPLESCRIPT
tell application "iTerm2"
  activate
  if (count of windows) = 0 then
    create window with default profile
  end if
  tell current window
    set newTab to (create tab with default profile)
    tell newTab
      tell current session
        write text "${title_esc}"
        write text "${attach_esc}"
      end tell
    end tell
  end tell
end tell
APPLESCRIPT
}

# Returns (on stdout) the codersync agent prefix a live tmux session
# name starts with ("claude-", "codex-", or "pair-"), or fails if it
# doesn't match any of them. Shared by every place that needs to
# recognize/strip that prefix, so the claude-/codex-/pair- detection
# lives in exactly one spot.
session_prefix_for() {
  case "$1" in
    claude-*) printf 'claude-' ;;
    codex-*)  printf 'codex-' ;;
    pair-*)   printf 'pair-' ;;
    *) return 1 ;;
  esac
}

# True if `raw` (a live tmux session's own RAW post-prefix text --
# e.g. "1-devbox-example-com-foo", or "devbox-example-com-foo" for a
# no-ID legacy session -- NOT run through parse_numbered_session/
# canonicalized) exactly matches some registry entry's own raw
# ENTRY_NAME, for the CURRENTLY configured target.
#
# Compared as RAW TEXT, not canonical id+rest -- deliberately. A
# session actually created by this tool always has IDENTICAL raw text
# in the registry and in its live tmux name, by construction
# (register_session stores the exact same string remote_setup/
# remote_setup_tmux_mode use to build the session name). Canonical
# id+rest matching used to be the check instead, which meant two
# DIFFERENT raw spellings that happen to canonicalize to the same
# value -- e.g. a registry entry "08-devbox-example-com-foo" and an
# unrelated live "pair-8-devbox-example-com-foo" that was never
# actually registered -- were wrongly treated as the SAME session:
# --list-all showed the live one as managed, --attach on it failed
# ("registered but not alive", since --attach's own lookup DOES
# compare raw text and correctly found no match), and --kill on the
# shared canonical ID killed the live, unregistered session and then
# deleted the unrelated registry entry it happened to collide with
# (confirmed live, reproduced exactly this way).
#
# This used to also trust an IDed session by naming SHAPE alone --
# first "a prefix plus any valid ID" (confirmed live: an unrelated
# session literally named "pair-1-not-codersync" was still
# listed/killed), then "a prefix plus a valid ID AND a rest starting
# with the target's label" (confirmed live AGAIN: for a target labeled
# e.g. "host", "pair-1-host-unregistered" still matched -- common
# target labels make that prefix trivial to collide with by accident).
# Full registry-backing is the only check narrow enough to avoid yet
# another naming collision, and it costs no real functionality:
# register_session() always runs BEFORE remote_setup/
# remote_setup_tmux_mode actually create the live session (see the
# ID-lock comment in the dispatch code below), so any session THIS
# tool creates is already registered by the time it exists to be
# listed/killed at all.
#
# A registry entry whose own first segment LOOKS like an ID attempt but
# fails canonicalization (e.g. "0-host-foo") is poisoned -- skipped
# outright, rather than being used to authorize anything (confirmed
# live: without this, a poisoned entry and a live session sharing that
# exact broken shape could authorize each other).
session_is_owned() {
  local raw="$1"
  touch "$REGISTRY"
  local line
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    parse_registry_line "$line"
    [[ "$ENTRY_TARGET" != "$SSH_TARGET" ]] && continue
    if [[ "$ENTRY_NAME" =~ ^([0-9]+)-(.*)$ ]] && ! canonicalize_session_id "${BASH_REMATCH[1]}" >/dev/null; then
      continue
    fi
    [[ "$ENTRY_NAME" == "$raw" ]] && return 0
  done < "$REGISTRY"
  return 1
}

# Appends session to the registry if it isn't already recorded, tagged
# with the CURRENT ssh-target (format: "<target>\t<session-name>" per
# line). Storing the target is what lets restore_all tell "genuinely
# dead" apart from "belongs to a different box than the one currently
# configured" -- without it, switching --setup to a different box and
# running --restore-all silently deleted every entry for the PREVIOUS
# box, since they don't show up in the current box's tmux session list
# either way and looked indistinguishable from stale ones.
register_session() {
  local session="$1"
  touch "$REGISTRY"
  local line="${SSH_TARGET}"$'\t'"${session}"
  grep -qxF "$line" "$REGISTRY" || echo "$line" >> "$REGISTRY"
}

# Acquires a simple mkdir-based lock around ID allocation + registry
# append (see the dispatch code that calls this), so two concurrent
# `codersync <name>` invocations for the same name can't both read the
# same next_id/registry state before either has written anything, and
# each mint their own new ID for what the user meant as one session --
# confirmed live by racing two invocations, which produced two separate
# tmux sessions instead of one. `mkdir` is atomic on any POSIX
# filesystem (including macOS's default APFS/HFS+), so this doesn't need
# `flock`, which isn't universally available on macOS. Retries for 5s
# before giving up, in case a previous run crashed and left the lock
# directory behind rather than blocking forever; the failure message
# tells the user how to recover.
acquire_id_lock() {
  local lock_dir="$CONFIG_DIR/id.lock"
  mkdir -p "$CONFIG_DIR"
  local waited_ms=0
  while ! mkdir "$lock_dir" 2>/dev/null; do
    if ((waited_ms >= 5000)); then
      echo "codersync: couldn't acquire the session-ID lock at ${lock_dir} after 5s -- remove it manually if you're sure no other codersync invocation is running." >&2
      return 1
    fi
    sleep 0.1
    waited_ms=$((waited_ms + 100))
  done
}

release_id_lock() {
  rmdir "$CONFIG_DIR/id.lock" 2>/dev/null || true
}

# Separate from id.lock (NOT reused) because mark_pending is called
# while the caller is STILL holding id.lock (see the dispatch case's
# comment on why the marker has to be written before id.lock is
# released) -- mkdir-based locks aren't reentrant, so acquiring id.lock
# a second time from inside the same invocation would just block for 5s
# and fail. This one only ever guards the three pending-file functions
# below, held briefly (a single read-modify-write of a small local
# file, no network I/O), so it's never held long enough to matter for
# concurrent unrelated invocations.
acquire_pending_lock() {
  local lock_dir="$CONFIG_DIR/pending.lock"
  mkdir -p "$CONFIG_DIR"
  local waited_ms=0
  while ! mkdir "$lock_dir" 2>/dev/null; do
    if ((waited_ms >= 5000)); then
      echo "codersync: couldn't acquire the pending-file lock at ${lock_dir} after 5s -- remove it manually if you're sure no other codersync invocation is running." >&2
      return 1
    fi
    sleep 0.1
    waited_ms=$((waited_ms + 100))
  done
}

release_pending_lock() {
  rmdir "$CONFIG_DIR/pending.lock" 2>/dev/null || true
}

# Marks a just-registered session as "still being created" -- the
# normal creation path releases id.lock right after register_session
# (deliberately, before the slow remote SSH setup -- see the dispatch
# case's own comment), which opens a window where the registry has the
# entry but no live tmux session exists yet. Without a marker covering
# that window, restore_all/kill_all_sessions can't tell "just registered,
# remote setup still running" apart from "genuinely dead", and prune the
# brand-new entry -- confirmed live by registering an entry, holding off
# on remote_setup, and running --restore-all in between: it deleted the
# entry a split second before the real tmux session came up, leaving the
# session alive but registry-orphaned. Called by the dispatch case
# BEFORE it releases id.lock, not after, so there's no gap between the
# registry write and the marker existing for restore_all to race into
# (confirmed live: writing the marker after releasing id.lock let
# --restore-all delete a registered-but-not-yet-pending entry in that
# exact gap). Appends rather than overwrites since more than one
# creation can be in flight at once.
mark_pending() {
  local session="$1"
  mkdir -p "$CONFIG_DIR"
  acquire_pending_lock || return 1
  # Armed only after the lock is actually held, so a Ctrl-C, a `set -e`
  # exit from the write below failing, or any other interruption while
  # the lock is held still releases it -- without this, the lock
  # directory was left behind and blocked every later codersync
  # invocation that touches pending state for 5s until someone noticed
  # and removed it by hand.
  trap 'release_pending_lock' EXIT
  printf '%s\n' "$(date +%s)"$'\t'"${SSH_TARGET}"$'\t'"${session}" >> "$PENDING_FILE"
  trap - EXIT
  release_pending_lock
}

# Removes this session's own pending marker once remote setup has
# finished (or the creation path is giving up -- wired to an EXIT trap
# so a crash/Ctrl-C still clears it, though a hard kill -9 skips traps
# entirely, which is exactly what PENDING_TTL_SECONDS is for). Locked
# the same as mark_pending/is_pending: this does a full
# read-then-rewrite of the whole file, which without a lock could race
# a concurrent mark_pending/clear_pending for a DIFFERENT in-flight
# session -- e.g. this read the file before that session's mark_pending
# appended its line, then this rewrite wrote back a stale snapshot that
# silently dropped the other session's marker (confirmed live with two
# overlapping creations racing this exact read-modify-write).
clear_pending() {
  local session="$1"
  acquire_pending_lock || return 1
  # See mark_pending's comment: armed only once the lock is held, so an
  # interruption mid-rewrite still releases it instead of leaving
  # pending.lock behind.
  trap 'release_pending_lock' EXIT
  if [[ -f "$PENDING_FILE" ]]; then
    local line kept=()
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      local ts="${line%%$'\t'*}" rest="${line#*$'\t'}"
      local ptarget="${rest%%$'\t'*}" pname="${rest#*$'\t'}"
      if [[ "$ptarget" == "$SSH_TARGET" && "$pname" == "$session" ]]; then
        continue
      fi
      kept+=("${ts}"$'\t'"${ptarget}"$'\t'"${pname}")
    done < "$PENDING_FILE"
    if [[ ${#kept[@]} -gt 0 ]]; then
      printf '%s\n' "${kept[@]}" > "$PENDING_FILE"
    else
      : > "$PENDING_FILE"
    fi
  fi
  trap - EXIT
  release_pending_lock
}

# Whether (target, name) has an unexpired pending marker -- checked by
# restore_all before pruning an entry with no live tmux session, so an
# in-flight creation isn't mistaken for a dead one. Markers older than
# PENDING_TTL_SECONDS are ignored (treated as an abandoned marker from a
# crashed run, per clear_pending's comment) rather than protecting an
# entry forever. Locked the same as mark_pending/clear_pending so a read
# here can't land mid-rewrite of clear_pending's full-file rewrite.
# The timestamp field is validated as all-digits before any arithmetic
# on it -- a hand-edited or corrupted pending file with a non-numeric
# timestamp used to crash restore_all outright with "unbound variable"
# under set -u the moment `(( now - ts ))` tried to evaluate it
# (confirmed live); such a row is now just treated as not-pending
# (falling through to whatever restore_all would otherwise do with no
# marker at all) rather than trusted or crashing.
#
# Three distinct return codes, NOT just true/false -- 0 (pending), 1
# (not pending), and 2 (couldn't tell: the pending-file lock was
# contended). Collapsing 2 into 1 used to mean a merely-CONTENDED lock
# looked identical to "definitely not pending" to every caller, so
# restore_all would prune a genuinely in-flight entry the instant this
# lock happened to be held by another invocation at the wrong moment --
# confirmed live: a fresh, valid pending marker plus a pre-held
# pending.lock still got the registry entry deleted, because the lock
# failure and "no marker found" were indistinguishable. Callers must
# treat 2 as "don't know" and default to NOT pruning, same as if it
# were pending.
#
# Deliberately does NOT arm its own EXIT trap around the lock hold,
# unlike mark_pending/clear_pending -- bash EXIT traps are a single
# global slot, not a stack, so a nested `trap '...' EXIT` here would
# silently clobber an OUTER caller's own trap the instant it's armed,
# and disarming back to `trap - EXIT` at the end doesn't restore
# whatever was there before, it just erases it (confirmed live:
# restore_all arms `release_id_lock` as its own EXIT trap around its
# final registry write, then calls is_pending from inside that same
# section -- with a trap here, THAT call silently replaced
# release_id_lock with release_pending_lock and then blanked it
# entirely, so by the time the write later failed there was no trap
# left at all to release id.lock). Safe to leave untrapped: unlike
# mark_pending/clear_pending, this function never WRITES anything --
# only reads plus in-memory string/arithmetic ops -- so the realistic
# odds of it failing mid-lock (as opposed to failing the up-front
# acquire, which is already handled) are low enough not to justify
# reintroducing that clobbering risk.
is_pending() {
  local target="$1" name="$2"
  [[ -f "$PENDING_FILE" ]] || return 1
  acquire_pending_lock || return 2
  local now line found=1
  now="$(date +%s)"
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local ts="${line%%$'\t'*}" rest="${line#*$'\t'}"
    local ptarget="${rest%%$'\t'*}" pname="${rest#*$'\t'}"
    [[ "$ptarget" == "$target" && "$pname" == "$name" ]] || continue
    [[ "$ts" =~ ^[0-9]+$ ]] || continue
    if (( now - ts < PENDING_TTL_SECONDS )); then
      found=0
      break
    fi
  done < "$PENDING_FILE"
  release_pending_lock
  return "$found"
}

# Prints (one per line, normalized to "target<TAB>name") every current
# $REGISTRY entry NOT already accounted for in $1 -- a $'\n'-delimited
# set of "target<TAB>name" keys the caller collected while reading its
# OWN (now possibly stale) snapshot of the registry earlier. Meant to
# be called right before a prune/kill function's final registry
# rewrite, under id.lock, so a concurrent register_session append that
# landed after that snapshot was read but before the rewrite commits
# isn't silently lost -- restore_all/kill_sessions/kill_all_sessions
# read the registry once (restore_all's read is spread across a whole
# loop of slow remote calls; kill_sessions/kill_all_sessions's kill
# calls happen before their one read), decide what to prune/keep from
# that snapshot, and only THEN rewrite -- id.lock isn't held for that
# entire span (it would otherwise serialize creation against these,
# often much slower, commands for far too long), so a `codersync <name>`
# invocation's register_session append could land in the gap and get
# silently overwritten by the stale rewrite (confirmed live: an append
# landing in exactly this window disappeared the moment the reader's
# rewrite committed). Newly-arrived lines are kept as-is here, not
# pruned/killed, since nothing in the caller's original pass ever
# checked their liveness -- the same "don't destroy what you haven't
# verified" rule as everywhere else in this file.
merge_concurrent_registry_additions() {
  local already_seen="$1"
  touch "$REGISTRY"
  local line key
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    parse_registry_line "$line"
    key="${ENTRY_TARGET}"$'\t'"${ENTRY_NAME}"
    case "$already_seen" in
      *$'\n'"$key"$'\n'*) continue ;;
    esac
    printf '%s\n' "$key"
  done < "$REGISTRY"
}

# Reopens a tab for every registry entry that belongs to the currently
# configured target and still has a live tmux session there, and prunes
# entries that don't. Each entry might be either split mode -- detected
# from which pattern is actually alive (claude-<name>/codex-<name> for
# iterm mode, pair-<name> for tmux mode), not stored separately.
#
# Entries for a DIFFERENT target (from before a later `--setup` pointed
# codersync elsewhere) are left completely untouched: not restored (would
# need connecting to that other box), not pruned (they might be alive
# and well there, just not checkable from here).
#
# Entries written before this per-target format existed are bare names
# with no tab -- treated as belonging to the current target (a
# reasonable one-time migration assumption, since anything already in
# the registry was necessarily created against whatever was configured
# at the time).
restore_all() {
  touch "$REGISTRY"
  local live
  # The whole remote command must be passed as ONE pre-quoted string --
  # see the ssh gotcha note near the top of this file.
  live="$(ssh "$SSH_TARGET" -- "tmux list-sessions -F '#{session_name}'" 2>/dev/null || true)"

  local kept=()
  local restored=0
  local skipped_other_target=0
  local skipped_unsafe=0
  local seen_lines=$'\n'
  local -a provisional_prune=()
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    parse_registry_line "$line"
    local entry_target="$ENTRY_TARGET" entry_name="$ENTRY_NAME"

    # Exact duplicate LINES (identical target+name -- e.g. a stale
    # double-write from before find_or_assign_id's own de-dup existed)
    # are collapsed to a single kept entry and a single restore
    # attempt here. Without this, each duplicate independently looked
    # "alive" against the same live session and got separately
    # restored/opened -- a tab opened once PER duplicate line instead
    # of once total, and the registry rewritten with the same
    # duplicate still intact afterward (confirmed live with a stubbed
    # remote: --restore-all opened the same session twice and never
    # actually resolved the duplication, leaving find_or_assign_id's
    # own "run --restore-all to fix this" advice pointing at something
    # that didn't fix it).
    local dup_key="${entry_target}"$'\t'"${entry_name}"
    case "$seen_lines" in
      *$'\n'"$dup_key"$'\n'*) continue ;;
    esac
    seen_lines+="$dup_key"$'\n'

    if [[ "$entry_target" != "$SSH_TARGET" ]]; then
      kept+=("${entry_target}"$'\t'"${entry_name}")
      skipped_other_target=$((skipped_other_target + 1))
      continue
    fi

    # entry_name gets spliced UNQUOTED into a remote bash heredoc by
    # remote_setup/remote_setup_tmux_mode below (tmux -s/-t need the
    # actual session name, not an escaped one) -- a registry poisoned by
    # hand-editing, a bug, or a pre-validation version of this script
    # could contain shell metacharacters, which then become literal
    # remote shell syntax (confirmed live with an entry like
    # "pair-x;touch /tmp/pwn"). Dropped rather than kept, since an entry
    # that fails this check is untrustworthy regardless of what wrote it.
    if ! validate_session_name "$entry_name"; then
      echo "Skipping unsafe registry entry (contains characters outside a-z/0-9/_/- ): $entry_name" >&2
      skipped_unsafe=$((skipped_unsafe + 1))
      continue
    fi
    # A safe CHARACTER set alone doesn't mean a safe ID: an entry like
    # "0-devbox-example-com-foo" passes the check above (every character is
    # allowed) but has a digit-shaped first segment that fails
    # canonicalization (0 is never a valid ID) -- the exact same
    # poisoned-entry shape session_is_owned() already rejects for
    # --list-all/--kill/--kill-all. restore_all had its own, older,
    # separate gating logic that never applied that check, so a
    # registry line like this was rejected everywhere else but still
    # restored here -- confirmed live, it called remote_setup_tmux_mode
    # with "0-devbox-example-com-foo" outright.
    if [[ "$entry_name" =~ ^([0-9]+)-(.*)$ ]] && ! canonicalize_session_id "${BASH_REMATCH[1]}" >/dev/null; then
      echo "Skipping unsafe registry entry (invalid ID segment): $entry_name" >&2
      skipped_unsafe=$((skipped_unsafe + 1))
      continue
    fi

    local has_claude=0 has_codex=0 has_pair=0
    grep -qxF "claude-${entry_name}" <<<"$live" && has_claude=1
    grep -qxF "codex-${entry_name}" <<<"$live" && has_codex=1
    grep -qxF "pair-${entry_name}" <<<"$live" && has_pair=1

    if [[ "$has_claude" == 1 && "$has_codex" == 1 ]]; then
      echo "Restoring (iterm-split): $entry_name"
      # Args here don't matter: both sessions already exist, so
      # `tmux new-session` just no-ops and nothing gets (re)launched.
      remote_setup "$entry_name" claude codex
      open_tab "$entry_name"
      kept+=("${entry_target}"$'\t'"${entry_name}")
      restored=$((restored + 1))
    elif [[ "$has_pair" == 1 ]]; then
      echo "Restoring (tmux-split): $entry_name"
      remote_setup_tmux_mode "$entry_name" claude codex
      open_tab_tmux_mode "$entry_name"
      kept+=("${entry_target}"$'\t'"${entry_name}")
      restored=$((restored + 1))
    elif [[ "$has_claude" == 1 || "$has_codex" == 1 ]]; then
      # Only one side of an iterm-split pair survives -- the other was
      # likely killed on purpose. Not calling remote_setup here is the
      # point: it would otherwise recreate the missing half with default
      # claude/codex, silently discarding whatever --tools the pair was
      # originally created with (which this registry doesn't track).
      # Kept in the registry since it's not actually dead -- pruning it
      # would make a later restore-all forget about the surviving pane.
      echo "Skipping '$entry_name': only one of claude/codex is still alive -- not auto-recreating the other with default tools. Run codersync again with this session's name if you want both back."
      kept+=("${entry_target}"$'\t'"${entry_name}")
    else
      local pending_status=0
      is_pending "$entry_target" "$entry_name" || pending_status=$?
      if [[ "$pending_status" == 0 ]]; then
        # No live tmux session yet, but a creation for this exact entry
        # is still in flight (see mark_pending) -- kept as-is rather
        # than pruned, since the remote session may finish appearing a
        # moment later. Not restored either: there's nothing to
        # restore, the in-flight creation will open its own tab when it
        # completes.
        echo "Skipping '$entry_name': session creation still in progress, not pruning yet."
        kept+=("${entry_target}"$'\t'"${entry_name}")
      elif [[ "$pending_status" == 2 ]]; then
        # is_pending couldn't acquire the pending-file lock, so there's
        # no way to tell pending apart from not-pending here -- kept
        # rather than pruned, on the same "don't destroy what you
        # haven't verified" principle as everywhere else in this
        # function. Without this, a merely-contended lock looked
        # identical to "definitely not pending" and pruned a genuinely
        # in-flight entry (confirmed live).
        echo "Skipping '$entry_name': couldn't check its pending status (pending-file lock contended) -- not pruning it this run." >&2
        kept+=("${entry_target}"$'\t'"${entry_name}")
      else
        # NOT pruned yet, even though this check just came back
        # "confirmed not pending" -- this read of $REGISTRY (and this
        # is_pending check) both happened without id.lock, so a
        # concurrent creation's register_session (which writes the
        # registry row this loop just saw) can land BEFORE its own
        # mark_pending (both happen under id.lock, in that order, but
        # this loop isn't synchronized against either write) -- i.e.
        # this entry can be legitimately mid-creation RIGHT NOW even
        # though the marker didn't exist yet at the instant we checked.
        # Deferred to a final recheck under id.lock instead of pruning
        # immediately here (confirmed live: this exact gap left the
        # registry empty while a fresh pending marker for the pruned
        # entry remained).
        provisional_prune+=("${entry_target}"$'\t'"${entry_name}")
      fi
    fi
  done < "$REGISTRY"

  # Held from here through the final write, not the whole function
  # (which made all those slow remote restore calls above) -- see
  # merge_concurrent_registry_additions's own comment for why the merge
  # step exists. Armed only now that the lock is actually held, so a
  # Ctrl-C or a failed write below still releases it instead of leaving
  # id.lock behind for 5s.
  acquire_id_lock || exit 1
  trap 'release_id_lock' EXIT

  # Final say on every entry provisionally marked stale above -- this
  # is the FIRST point in this function where that decision is made
  # under id.lock, serialized against any `codersync <name>` invocation
  # that might be reusing this exact row. A creation always writes its
  # registry row and its pending marker in that order, BOTH while
  # holding id.lock, before ever releasing it -- so by the time this
  # acquire above succeeds, any such invocation has either not started
  # yet (nothing written), or has fully finished both writes (marker
  # exists) before we got the lock. There's no in-between state left to
  # observe here, unlike the un-locked check during the loop above.
  if [[ ${#provisional_prune[@]} -gt 0 ]]; then
    local pp_key pp_target pp_name pending_status
    for pp_key in "${provisional_prune[@]}"; do
      pp_target="${pp_key%%$'\t'*}"
      pp_name="${pp_key#*$'\t'}"
      pending_status=0
      is_pending "$pp_target" "$pp_name" || pending_status=$?
      if [[ "$pending_status" == 0 ]]; then
        echo "Skipping '$pp_name': session creation still in progress, not pruning yet."
        kept+=("${pp_target}"$'\t'"${pp_name}")
      elif [[ "$pending_status" == 2 ]]; then
        echo "Skipping '$pp_name': couldn't check its pending status (pending-file lock contended) -- not pruning it this run." >&2
        kept+=("${pp_target}"$'\t'"${pp_name}")
      else
        echo "Pruning stale entry (no live tmux session): $pp_name"
      fi
    done
  fi

  while IFS= read -r line; do
    [[ -n "$line" ]] && kept+=("$line")
  done < <(merge_concurrent_registry_additions "$seen_lines")
  if [[ ${#kept[@]} -gt 0 ]]; then
    printf '%s\n' "${kept[@]}" > "$REGISTRY"
  else
    : > "$REGISTRY"
  fi
  trap - EXIT
  release_id_lock
  if [[ "$skipped_other_target" -gt 0 ]]; then
    echo "Skipped ${skipped_other_target} entry/entries for a different configured box -- re-run --setup for that box, then --restore-all again, to check those."
  fi
  if [[ "$skipped_unsafe" -gt 0 ]]; then
    echo "Dropped ${skipped_unsafe} unsafe registry entry/entries (see warnings above)."
  fi
  echo "Restored ${restored} session(s)."
}

# Resolves <id-or-name> to the raw, registry-stored session name for
# the current target -- shared by --attach and --rename, which both
# need exactly this: an ID (as shown by --list-all) or a plain name
# (what you originally typed to `codersync <name>`, without the
# target-label/ID prefixing that gets folded in), matched against THIS
# registry. Prints the raw entry name on stdout and returns 0 on a
# match; prints a clear message to stderr and returns 1 otherwise
# (callers exit 1 themselves -- this runs inside `$(...)`, where `exit`
# would only end the subshell, not the whole script).
#
# A purely-numeric argument is ALWAYS treated as an ID, never as a
# literal name, even though digits-only is technically a valid session
# name too -- same precedent as --kill, which never treats a numeric
# token as a literal name either. Registry-scoped, same as
# --list-all/--kill/--kill-all: a session alive on the box but not in
# THIS registry (different machine, cleared registry) won't be found
# here.
resolve_registered_session() {
  local arg="$1"
  touch "$REGISTRY"

  local found=0 entry_name=""
  local line

  if [[ "$arg" =~ ^[0-9]+$ ]]; then
    local canon
    if ! canon="$(canonicalize_session_id "$arg")"; then
      echo "codersync: '${arg}' isn't a valid session ID -- IDs start at 1, 0 is never assigned." >&2
      return 1
    fi
    local -a id_matches=()
    local id_seen=$'\n'
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      parse_registry_line "$line"
      [[ "$ENTRY_TARGET" != "$SSH_TARGET" ]] && continue
      parse_numbered_session "" "$ENTRY_NAME"
      if [[ "$PARSED_ID" == "$canon" ]]; then
        # ENTRY_NAME (returned AS-IS below, not reconstructed from
        # PARSED_ID/PARSED_REST) ends up spliced unquoted into a remote
        # bash heredoc by callers -- unlike the name branch below, where
        # a match requires exact equality with an already-validated,
        # known-safe string, ANY registry entry can match here purely by
        # having the right leading ID segment, so its REST is never
        # otherwise checked for safety. Same defense as restore_all:
        # reject rather than trust it.
        if ! validate_session_name "$ENTRY_NAME"; then
          echo "codersync: registry entry for ID ${canon} contains unsafe characters ('${ENTRY_NAME}') -- refusing to use it. Run codersync --restore-all to prune unsafe entries." >&2
          return 1
        fi
        # Exact duplicate LINES don't count as a second candidate --
        # see find_or_assign_id's own comment for why (a stale
        # double-write, not a genuine ambiguity).
        case "$id_seen" in
          *$'\n'"$ENTRY_NAME"$'\n'*) ;;
          *) id_seen+="$ENTRY_NAME"$'\n'; id_matches+=("$ENTRY_NAME") ;;
        esac
      fi
    done < "$REGISTRY"
    # Collected ALL matches instead of stopping at the first -- a
    # leftover pair of entries from a prior version's leading-zero bug
    # (e.g. both "8-devbox-example-com-foo" and
    # "08-devbox-example-com-foo" registered, only one of them actually
    # still live) used to make this just return whichever happened to
    # be first on disk, regardless of which one was real: --list-all
    # correctly showed the live one, but --attach on the same ID
    # resolved the OTHER, stale entry and reported it as "registered
    # but not alive" (confirmed live). Erroring instead of guessing,
    # same reasoning as find_or_assign_id's own duplicate check.
    if [[ ${#id_matches[@]} -gt 1 ]]; then
      echo "codersync: multiple registry entries match ID ${canon} on ${SSH_TARGET}: ${id_matches[*]} -- can't tell which is the real one. Run codersync --restore-all to prune whichever isn't actually alive, then try again." >&2
      return 1
    fi
    if [[ ${#id_matches[@]} -eq 1 ]]; then
      found=1
      entry_name="${id_matches[0]}"
    fi
    if [[ "$found" == 0 ]]; then
      echo "codersync: no session with ID ${canon} on ${SSH_TARGET}. Run codersync --list-all to see what's available." >&2
      return 1
    fi
  else
    if ! validate_session_name "$arg"; then
      echo "codersync: '${arg}' isn't a valid session ID or name -- an ID is a plain number (see --list-all), a name is letters/digits/'-'/'_' and can't start with '-'." >&2
      return 1
    fi
    local suffix="${TARGET_LABEL}-${arg}"
    local -a suffix_matches=()
    local suffix_seen=$'\n'
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      parse_registry_line "$line"
      [[ "$ENTRY_TARGET" != "$SSH_TARGET" ]] && continue
      parse_numbered_session "" "$ENTRY_NAME"
      if [[ "$PARSED_REST" == "$suffix" ]]; then
        # $suffix is built from an already-validated $arg, so a match
        # here can't actually contain anything unsafe -- checked anyway,
        # for the same reason `cd --` is still used even though
        # validate_remote_dir already rejects a leading dash: cheap
        # defense in depth, not the only thing standing between this and
        # a poisoned entry.
        if ! validate_session_name "$ENTRY_NAME"; then
          echo "codersync: registry entry for '${arg}' contains unsafe characters ('${ENTRY_NAME}') -- refusing to use it. Run codersync --restore-all to prune unsafe entries." >&2
          return 1
        fi
        # Exact duplicate LINES don't count as a second candidate --
        # see find_or_assign_id's own comment for why.
        case "$suffix_seen" in
          *$'\n'"$ENTRY_NAME"$'\n'*) ;;
          *) suffix_seen+="$ENTRY_NAME"$'\n'; suffix_matches+=("$ENTRY_NAME") ;;
        esac
      fi
    done < "$REGISTRY"
    # Collected ALL matches instead of stopping at the first -- same
    # duplicate-entry scenario (and same fix) as the ID branch above:
    # two entries with the same rest but different id spellings (e.g.
    # "8-devbox-example-com-foo" and "08-devbox-example-com-foo") are
    # BOTH a match here, since PARSED_REST strips only the id- prefix
    # regardless of its own formatting.
    if [[ ${#suffix_matches[@]} -gt 1 ]]; then
      echo "codersync: multiple registry entries match '${arg}' on ${SSH_TARGET}: ${suffix_matches[*]} -- can't tell which is the real one. Run codersync --restore-all to prune whichever isn't actually alive, then try again." >&2
      return 1
    fi
    if [[ ${#suffix_matches[@]} -eq 1 ]]; then
      found=1
      entry_name="${suffix_matches[0]}"
    fi
    # Falls back to an EXACT, unprefixed match on $arg itself if no
    # labeled one was found -- `codersync --local` (see its own
    # comment) deliberately creates sessions with no target-label
    # prefix at all, since the box has no way to know what alias a
    # client will someday refer to it by. Checked only as a fallback,
    # after the labeled check above has already had first refusal, so
    # a normal client-created session with the same $arg text still
    # wins if both happen to exist.
    if [[ "$found" == 0 ]]; then
      while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        parse_registry_line "$line"
        [[ "$ENTRY_TARGET" != "$SSH_TARGET" ]] && continue
        parse_numbered_session "" "$ENTRY_NAME"
        if [[ "$PARSED_REST" == "$arg" ]]; then
          if ! validate_session_name "$ENTRY_NAME"; then
            echo "codersync: registry entry for '${arg}' contains unsafe characters ('${ENTRY_NAME}') -- refusing to use it. Run codersync --restore-all to prune unsafe entries." >&2
            return 1
          fi
          found=1
          entry_name="$ENTRY_NAME"
          break
        fi
      done < "$REGISTRY"
    fi
    if [[ "$found" == 0 ]]; then
      echo "codersync: no session named '${arg}' on ${SSH_TARGET}. Run codersync --list-all to see what's available." >&2
      return 1
    fi
  fi

  # entry_name is the RAW registry text (e.g. "08-devbox-example-com-foo"),
  # not reconstructed from the canonical id -- a live session named
  # "pair-08-devbox-example-com-foo" (--list-all shows it as ID 8, same
  # canonicalization every other command uses) would otherwise never
  # match a reconstructed "pair-8-devbox-example-com-foo", exactly the
  # bug --kill's own comment above describes and avoids the same way.
  printf '%s' "$entry_name"
}

# `codersync --attach <id-or-name>` -- reconnects to ONE specific
# existing session. Unlike plain `codersync <name>`, which creates a
# session if one doesn't already exist, this errors instead -- the
# whole point is reconnecting to something specific without any risk
# of a typo silently spinning up a brand-new paired session instead.
attach_session() {
  local arg="$1"
  local entry_name
  entry_name="$(resolve_registered_session "$arg")" || exit 1

  # Only reaches the network once a registry match is confirmed --
  # malformed input (bad ID, invalid name, no match at all) errors out
  # inside resolve_registered_session without ever touching SSH.
  local live
  live="$(ssh "$SSH_TARGET" -- "tmux list-sessions -F '#{session_name}'" 2>/dev/null || true)"

  local has_claude=0 has_codex=0 has_pair=0
  grep -qxF "claude-${entry_name}" <<<"$live" && has_claude=1
  grep -qxF "codex-${entry_name}" <<<"$live" && has_codex=1
  grep -qxF "pair-${entry_name}" <<<"$live" && has_pair=1

  if [[ "$has_claude" == 1 && "$has_codex" == 1 ]]; then
    # Args don't matter here: both sessions already exist, so `tmux
    # new-session` inside remote_setup just no-ops.
    remote_setup "$entry_name" claude codex
    open_tab "$entry_name"
  elif [[ "$has_pair" == 1 ]]; then
    remote_setup_tmux_mode "$entry_name" claude codex
    open_tab_tmux_mode "$entry_name"
  elif [[ "$has_claude" == 1 || "$has_codex" == 1 ]]; then
    # Same reasoning as restore_all's equivalent case: not auto-
    # recreating the missing half with default claude/codex, since that
    # would silently discard whatever --tools this pair actually used
    # (this registry doesn't track it).
    echo "codersync: only one side of '${entry_name}' is still alive on ${SSH_TARGET}. Run codersync with this session's plain name if you want the other side back too." >&2
    exit 1
  else
    echo "codersync: '${entry_name}' is registered but not alive on ${SSH_TARGET} anymore. Run codersync --restore-all to prune it, or start it fresh with its plain name." >&2
    exit 1
  fi
}

# `codersync --rename|-R <id-or-name> <new-name>` -- renames one
# specific existing session (looked up the same way as --attach) to a
# new plain name, keeping its numeric ID and everything else about it
# unchanged. Uses `tmux rename-session`, which only changes tmux's
# internal session name -- it doesn't touch, restart, or even briefly
# interrupt whatever's actually running inside (confirmed live).
#
# Known limitation, not specifically handled: a session renamed in the
# brief window between creation and its first attach would have the
# client-attached hook that fires its actual launch (see
# remote_setup_tmux_mode's comment) fail, since that hook has the OLD
# session name hardcoded into the command it runs. In practice this
# window is seconds at most -- open_tab/open_tab_tmux_mode attach
# immediately after creating a session -- so renaming something before
# ever looking at it once is exceedingly unlikely.
rename_session() {
  local arg="$1" new_name="$2"
  local old_entry_name
  old_entry_name="$(resolve_registered_session "$arg")" || exit 1

  if ! validate_session_name "$new_name"; then
    echo "codersync: '${new_name}' isn't a valid session name -- only letters, digits, '-', and '_' are allowed, and it can't start with '-'." >&2
    exit 1
  fi
  # Rejected for the same reason resolve_registered_session's ID branch
  # always wins over a same-shaped name: allowing it would make this
  # session unreachable by name afterward, since --attach/--kill always
  # read a purely-numeric argument as an ID first, never as a name.
  if [[ "$new_name" =~ ^[0-9]+$ ]]; then
    echo "codersync: '${new_name}' can't be a plain number -- --attach/--kill always read a numeric argument as an ID, never a name, so a session named that would be unreachable by name afterward." >&2
    exit 1
  fi

  # Keeps the same numeric ID (or stays ID-less, for a pre-numbering
  # legacy entry) -- renaming changes what a session is CALLED, not
  # its identity.
  parse_numbered_session "" "$old_entry_name"
  local old_id="$PARSED_ID"
  local new_entry_name="${TARGET_LABEL}-${new_name}"
  [[ -n "$old_id" ]] && new_entry_name="${old_id}-${new_entry_name}"

  if [[ "$new_entry_name" == "$old_entry_name" ]]; then
    echo "codersync: '${arg}' is already named '${new_name}'." >&2
    exit 1
  fi

  # Locked from here through the registry write at the end (including
  # the remote SSH rename in between) -- the normal `codersync <name>`
  # creation path takes this same lock around ITS OWN registry
  # reservation (see the dispatch case's comment), so without it here
  # too, a concurrent `codersync <name>` using the same target name as
  # $new_name could insert a colliding entry between this collision
  # check and the write below, defeating the uniqueness the check
  # exists for. Held across the network round-trip too, unlike the
  # creation path (which releases before its own slow remote work):
  # this function's registry write only happens AFTER the remote rename
  # succeeds, so releasing early would let a concurrent writer interleave
  # between a collision check that already passed and a write that
  # hasn't happened yet.
  acquire_id_lock || exit 1
  trap 'release_id_lock' EXIT

  # Compared against each candidate's REST, not the reconstructed
  # new_entry_name (which includes THIS session's own, preserved ID) --
  # two sessions can never actually collide on the full tmux/registry
  # name, since IDs are unique, but two different IDs sharing the same
  # rest is exactly the ambiguity resolve_registered_session's name
  # branch can't resolve (it takes the first match and stops), so it's
  # what actually needs rejecting here.
  touch "$REGISTRY"
  local line new_suffix="${TARGET_LABEL}-${new_name}"
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    parse_registry_line "$line"
    [[ "$ENTRY_TARGET" != "$SSH_TARGET" ]] && continue
    parse_numbered_session "" "$ENTRY_NAME"
    if [[ "$PARSED_REST" == "$new_suffix" ]]; then
      echo "codersync: '${new_name}' is already in use on ${SSH_TARGET} (as ${ENTRY_NAME}) -- pick a different name." >&2
      exit 1
    fi
  done < "$REGISTRY"

  local live
  live="$(ssh "$SSH_TARGET" -- "tmux list-sessions -F '#{session_name}'" 2>/dev/null || true)"
  local has_claude=0 has_codex=0 has_pair=0
  grep -qxF "claude-${old_entry_name}" <<<"$live" && has_claude=1
  grep -qxF "codex-${old_entry_name}" <<<"$live" && has_codex=1
  grep -qxF "pair-${old_entry_name}" <<<"$live" && has_pair=1

  if [[ "$has_claude" == 0 && "$has_codex" == 0 && "$has_pair" == 0 ]]; then
    echo "codersync: '${old_entry_name}' is registered but not alive on ${SSH_TARGET} anymore -- nothing to rename. Run codersync --restore-all to prune it." >&2
    exit 1
  fi

  # Preflight, checked against the SAME `live` already fetched above (no
  # extra round-trip): refuse if any DESTINATION name is already a live
  # session, registered or not. `tmux rename-session` itself would fail
  # on this too, but only AFTER possibly already renaming an earlier
  # side in the same remote script -- confirmed live, with a stubbed
  # remote: claude-* renamed successfully, then codex-* failed because
  # codex-<new> already existed, leaving the pair permanently split
  # between old and new names (registry, which only gets rewritten on
  # full success, reflected neither).
  #
  # Checked unconditionally across all three prefixes, NOT gated by
  # $has_claude/$has_codex/$has_pair (the SOURCE session's own mode) --
  # session_is_owned only ever matches on raw post-prefix text, never
  # on which prefix a live session actually uses, so an unrelated live
  # session
  # under a DIFFERENT prefix than the source's own mode would otherwise
  # get silently adopted as owned the moment the registry is rewritten
  # to the same id+rest. Confirmed live: renaming a tmux-mode (pair-only)
  # session onto a name where an unrelated claude-/codex- pair happened
  # to already exist succeeded with the old (mode-gated) checks, after
  # which --list-all/--kill treated that unrelated pair as owned too.
  if grep -qxF "claude-${new_entry_name}" <<<"$live"; then
    echo "codersync: can't rename to '${new_name}' -- a live tmux session already exists at 'claude-${new_entry_name}' on ${SSH_TARGET}." >&2
    exit 1
  fi
  if grep -qxF "codex-${new_entry_name}" <<<"$live"; then
    echo "codersync: can't rename to '${new_name}' -- a live tmux session already exists at 'codex-${new_entry_name}' on ${SSH_TARGET}." >&2
    exit 1
  fi
  if grep -qxF "pair-${new_entry_name}" <<<"$live"; then
    echo "codersync: can't rename to '${new_name}' -- a live tmux session already exists at 'pair-${new_entry_name}' on ${SSH_TARGET}." >&2
    exit 1
  fi

  # old_entry_name/new_entry_name are both already-validated, known-safe
  # strings (validate_session_name), but base64'd anyway before being
  # spliced into the remote heredoc -- same defense-in-depth convention
  # every other value in this file goes through one, not the only thing
  # standing between untrusted input and a remote shell.
  local old_b64 new_b64
  old_b64="$(b64 "$old_entry_name")"
  new_b64="$(b64 "$new_entry_name")"

  # shellcheck disable=SC2087 # intentional: local expansion is the point --
  # ${has_claude}/etc. and old_b64/new_b64 below are THIS script's
  # variables and must substitute before the heredoc is sent; only the
  # \$-escaped ones are meant to survive as literal text for the remote
  # shell to evaluate.
  #
  # Even with the preflight above, the remote rename-session calls still
  # roll back on any failure (same trap-based all-or-nothing pattern as
  # remote_setup's own comment) -- the preflight closes the most likely
  # gap (an unrelated destination session already existing), but doesn't
  # cover every conceivable mid-script failure, and for an iterm-split
  # pair, a half-renamed claude/codex split is exactly the broken state
  # this whole thing exists to prevent.
  if ! ssh "$SSH_TARGET" -- 'PATH="$HOME/.local/bin:$HOME/bin:$PATH" bash -s' <<EOF
set -e
old=\$(echo ${old_b64} | base64 -d)
new=\$(echo ${new_b64} | base64 -d)
renamed=""
rollback() {
  for x in \$renamed; do
    case "\$x" in
      claude) tmux rename-session -t "claude-\${new}" "claude-\${old}" 2>/dev/null || true ;;
      codex) tmux rename-session -t "codex-\${new}" "codex-\${old}" 2>/dev/null || true ;;
      pair) tmux rename-session -t "pair-\${new}" "pair-\${old}" 2>/dev/null || true ;;
    esac
  done
}
trap rollback EXIT
if [ "${has_claude}" = 1 ]; then tmux rename-session -t "claude-\${old}" "claude-\${new}"; renamed="\${renamed} claude"; fi
if [ "${has_codex}" = 1 ]; then tmux rename-session -t "codex-\${old}" "codex-\${new}"; renamed="\${renamed} codex"; fi
if [ "${has_pair}" = 1 ]; then tmux rename-session -t "pair-\${old}" "pair-\${new}"; renamed="\${renamed} pair"; fi
trap - EXIT
EOF
  then
    echo "codersync: failed to rename '${arg}' to '${new_name}' on ${SSH_TARGET} -- any partial rename was rolled back." >&2
    exit 1
  fi

  local -a kept=()
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    parse_registry_line "$line"
    if [[ "$ENTRY_TARGET" == "$SSH_TARGET" && "$ENTRY_NAME" == "$old_entry_name" ]]; then
      kept+=("${SSH_TARGET}"$'\t'"${new_entry_name}")
    else
      kept+=("$line")
    fi
  done < "$REGISTRY"
  printf '%s\n' "${kept[@]}" > "$REGISTRY"

  trap - EXIT
  release_id_lock

  echo "Renamed '${old_entry_name}' to '${new_entry_name}' on ${SSH_TARGET}."
}

# Queries the currently configured target's live tmux sessions and
# prints a table of every codersync-managed one (claude-<id>-<rest>/
# codex-<id>-<rest> pairs, or pair-<id>-<rest> sessions), one row per
# logical session regardless of split mode. See session_is_owned() for
# what qualifies a session to show up at all -- registry-backing is
# required either way, but this is still reading LIVE tmux state, not
# just the registry file, so a registered session that's since died
# (killed outside codersync, the box rebooted, whatever) correctly
# doesn't show up here even though its registry entry might still
# exist -- only --restore-all prunes that entry.
list_all_sessions() {
  local live
  live="$(ssh "$SSH_TARGET" -- "tmux list-sessions -F '#{session_name}'" 2>/dev/null || true)"
  if [[ -z "$live" ]]; then
    echo "No sessions on ${SSH_TARGET}."
    return 0
  fi

  # A newline-wrapped string used as a de-dup set (instead of an
  # associative array -- see parse_kill_spec's comment for why: macOS's
  # own bash 3.2 doesn't support `local -A` at all). An iterm-split pair
  # is TWO live tmux sessions (claude-<id>-<rest>, codex-<id>-<rest>) for
  # ONE logical row, so this still needs an explicit check during the
  # loop -- not just a sort -u at the end -- to collapse them into one.
  local seen_keys=$'\n'
  local -a rows=()
  local line prefix kind key
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    prefix="$(session_prefix_for "$line")" || continue
    kind="iterm"
    [[ "$prefix" == "pair-" ]] && kind="tmux"
    parse_numbered_session "$prefix" "$line"
    session_is_owned "${line#"$prefix"}" || continue
    key="${kind}:${PARSED_ID}:${PARSED_REST}"
    case "$seen_keys" in
      *$'\n'"$key"$'\n'*) continue ;;
    esac
    seen_keys+="$key"$'\n'
    local id_display="${PARSED_ID:--}"
    local id_sort="${PARSED_ID:-999999}"
    # Strips the "${TARGET_LABEL}-" prefix for display, if present --
    # PARSED_REST is always "${TARGET_LABEL}-${RAW_NAME}" for a session
    # actually created by this tool (see the dispatch case's own
    # SESSION_SUFFIX comment), but --attach/--rename take the bare
    # RAW_NAME, reconstructing the label internally themselves.
    # Without stripping it here, this column showed a string that
    # looked directly attachable/renameable by name but wasn't --
    # passing it back verbatim produced a double-prefixed, never-found
    # lookup (confirmed live). A no-op for anything that doesn't
    # actually start with that prefix (a hand-created or pre-labeling
    # legacy session), via `#` removing nothing if it doesn't match.
    local display_rest="${PARSED_REST#"${TARGET_LABEL}-"}"
    rows+=("$(printf '%06d\t%s\t%s\t%s' "$id_sort" "$id_display" "$kind" "$display_rest")")
  done <<<"$live"

  if [[ ${#rows[@]} -eq 0 ]]; then
    echo "No codersync sessions on ${SSH_TARGET}."
    return 0
  fi

  printf '%-6s %-8s %s\n' "ID" "MODE" "SESSION"
  printf '%s\n' "${rows[@]}" | sort -n | while IFS=$'\t' read -r _ id_display kind rest; do
    printf '%-6s %-8s %s\n' "$id_display" "$kind" "$rest"
  done
}

# Kills one remote tmux session by its exact name, safely regardless of
# what that name contains. `name` here always comes from either the
# registry or live `tmux list-sessions` output -- neither is guaranteed
# to satisfy validate_session_name (a rogue/legacy/hand-created tmux
# session can be named anything tmux itself allows), and passing it as a
# separate ssh argument is NOT safe: ssh rejoins a multi-argument remote
# command with plain spaces before the remote shell parses it (see the
# ssh gotcha note near the top of this file), so a name containing shell
# metacharacters becomes remote shell syntax at that point -- confirmed
# with a session named `pair-1-x; touch /tmp/pwn`. Base64-encoding it and
# decoding into a remote variable (the same technique used for --tools'
# resolved bin/cmd values in remote_setup above) closes that off no
# matter what the name contains; the heredoc also gives this ssh call its
# own stdin, avoiding the same loop-stdin-forwarding issue documented at
# each call site below.
remote_kill_session() {
  local name="$1"
  local name_b64
  name_b64="$(b64 "$name")"
  # Also removes /tmp/codersync-<name>-*.sh -- the launch script(s) this
  # session's own /tmp file(s) are named after (one file for an
  # iterm-split session, two for a tmux-split pair; the glob covers
  # either since a pair's own two filenames both start with
  # "codersync-<pair-session-name>-"). Without this, killing a session
  # BEFORE it was ever attached to (so its script's own self-delete line
  # -- see remote_setup's comment -- never got a chance to run) left the
  # file behind indefinitely -- confirmed live, over a dozen leftover
  # scripts accumulated on devbox purely from --kill'ing test sessions
  # during this tool's own development.
  #
  # That cleanup only runs when `name` matches codersync's own generated
  # session-name shape (letters/digits/underscore/dash only), though --
  # quoting keeps it safe from shell injection either way, but doesn't
  # neutralize `/` as a PATH separator. `name` becomes a literal path
  # segment in the rm glob, so one containing `/` (e.g.
  # "pair-1-host/../../victim") could traverse outside /tmp entirely.
  # session_is_owned() requires registry-backing before a caller ever
  # gets this far, and a real registry entry can never contain `/`
  # (register_session only ever writes values that already passed
  # validate_session_name) -- so this only ever excludes a hand-crafted
  # registry entry from bypassing that via the cleanup path specifically;
  # the tmux-kill line above is unaffected and still runs regardless,
  # since it's already safe for any content via base64 encoding.
  local cleanup_cmd=""
  if [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]]; then
    # shellcheck disable=SC2016 # intentional: this is REMOTE-shell text
    # (uses the remote script's own $name, decoded below), not meant to
    # expand in this local single-quoted assignment.
    cleanup_cmd='rm -f -- /tmp/codersync-"$name"-*.sh'
  fi
  # shellcheck disable=SC2087 # intentional: local expansion is the point --
  # ${name_b64}/${cleanup_cmd} below are THIS script's variables and must
  # substitute before the heredoc is sent; only the \$-escaped one is
  # meant to survive as literal text for the remote shell to evaluate.
  ssh "$SSH_TARGET" -- 'PATH="$HOME/.local/bin:$HOME/bin:$PATH" bash -s' <<EOF 2>/dev/null
name=\$(echo ${name_b64} | base64 -d)
tmux kill-session -t "\$name" 2>/dev/null || true
${cleanup_cmd}
EOF
}

# Kills every remote session matching any ID in `spec` (see
# parse_kill_spec for the accepted formats: "1,2,4", "1-4", or a mix)
# and removes the corresponding registry entry. Scoped to the currently
# configured target, same as --list-all/--restore-all. An ID with no
# live match is reported and skipped rather than treated as fatal, so
# one typo in a list doesn't block killing the rest.
kill_sessions() {
  local spec="$1"
  local ids
  ids="$(parse_kill_spec "$spec")" || exit 1

  # Held across the WHOLE kill (every remote_kill_session call below,
  # not just the final registry cleanup that used to be all that took
  # it) -- a targeted kill drops the registry row for whatever it just
  # killed, but find_or_assign_id reuses an existing row's raw text for
  # a matching target+suffix, so a brand-new `codersync <same-name>`
  # invocation started right after the kill (but before this cleanup)
  # can legitimately re-claim -- and re-mark-pending, or even fully
  # recreate as live again -- that EXACT row before we get to drop it.
  # Re-checking just the pending marker under the lock wouldn't cover
  # the "already alive again" case, so instead of that, the lock is
  # held across the entire operation: no such invocation can even start
  # writing to the registry until this one releases it (confirmed live:
  # a targeted kill left registry_bytes=0 with a fresh pending marker
  # for the exact row it had just dropped).
  acquire_id_lock || exit 1
  trap 'release_id_lock' EXIT

  local live
  live="$(ssh "$SSH_TARGET" -- "tmux list-sessions -F '#{session_name}'" 2>/dev/null || true)"

  touch "$REGISTRY"
  local id any_killed=0
  local -a killed_pairs=()
  while IFS= read -r id; do
    [[ -z "$id" ]] && continue
    # Every live session is parsed/canonicalized via parse_numbered_session
    # and compared against the (already-canonical) requested id -- NOT
    # pre-grepped for the literal id text. A live session named e.g.
    # "pair-08-host-foo" canonicalizes to ID 8 in --list-all, but a raw
    # `grep "\-8-"` here would never match its actual on-disk text "08",
    # so --kill 8 (or --kill 08, which canonicalizes to the same request)
    # reported "no session found" for something --list-all had just shown
    # as killable (confirmed live). Ownership is then checked the same as
    # everywhere else -- see session_is_owned() -- so an ID with only
    # unowned candidates is reported the same as an ID with no candidates
    # at all (confirmed live: an unrelated session literally named
    # "pair-1-not-codersync" used to be killed by `--kill 1` even though
    # it has nothing to do with this target).
    local matches="" cname prefix
    while IFS= read -r cname; do
      [[ -z "$cname" ]] && continue
      prefix="$(session_prefix_for "$cname")" || continue
      parse_numbered_session "$prefix" "$cname"
      [[ "$PARSED_ID" == "$id" ]] || continue
      session_is_owned "${cname#"$prefix"}" || continue
      matches+="${cname}"$'\n'
    done <<<"$live"
    if [[ -z "$matches" ]]; then
      echo "codersync: no session found for ID ${id}" >&2
      continue
    fi

    local rest=""
    local name
    while IFS= read -r name; do
      [[ -z "$name" ]] && continue
      echo "Killing: $name"
      remote_kill_session "$name"
      if [[ -z "$rest" ]]; then
        prefix="$(session_prefix_for "$name")"
        parse_numbered_session "$prefix" "$name"
        rest="$PARSED_REST"
      fi
    done <<<"$matches"
    any_killed=1
    # Recorded as (id, rest) -- NOT the reconstructed raw string
    # "${id}-${rest}" -- so the registry cleanup below can compare
    # against each entry's OWN parsed (id, rest) instead of an exact
    # string match. A live session named e.g. "pair-08-devbox-example-com-foo"
    # kills correctly (id canonicalizes to 8), but the matching registry
    # entry is still literally "08-devbox-example-com-foo" on disk -- comparing
    # "8-devbox-example-com-foo" against that raw text never matched, leaving
    # the stale entry behind after every kill (confirmed live).
    [[ -n "$rest" ]] && killed_pairs+=("${id}"$'\t'"${rest}")
  done <<<"$ids"

  if [[ ${#killed_pairs[@]} -gt 0 ]]; then
    local -a kept=()
    local line kp drop
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      parse_registry_line "$line"
      drop=0
      if [[ "$ENTRY_TARGET" == "$SSH_TARGET" ]]; then
        parse_numbered_session "" "$ENTRY_NAME"
        for kp in "${killed_pairs[@]}"; do
          if [[ "$kp" == "${PARSED_ID}"$'\t'"${PARSED_REST}" ]]; then
            drop=1
            break
          fi
        done
      fi
      [[ "$drop" == 0 ]] && kept+=("$line")
    done < "$REGISTRY"
    if [[ ${#kept[@]} -gt 0 ]]; then
      printf '%s\n' "${kept[@]}" > "$REGISTRY"
    else
      : > "$REGISTRY"
    fi
  fi

  trap - EXIT
  release_id_lock

  if [[ "$any_killed" == 0 ]]; then
    echo "Nothing killed."
  fi
}

# Kills every codersync-managed session on the currently configured
# target -- see session_is_owned() for what qualifies a live session at
# all (same rule as list_all_sessions/kill_sessions: an exact registry
# match on both id and rest) -- and clears every registry entry for
# that target. Asks for confirmation first since, unlike --kill's
# targeted list, there's no way to undo picking the wrong box. Other
# targets' registry entries are left untouched, same scoping as
# --list-all/--kill.
kill_all_sessions() {
  local live
  live="$(ssh "$SSH_TARGET" -- "tmux list-sessions -F '#{session_name}'" 2>/dev/null || true)"
  local -a matches=()
  local name prefix
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    prefix="$(session_prefix_for "$name")" || continue
    parse_numbered_session "$prefix" "$name"
    session_is_owned "${name#"$prefix"}" || continue
    matches+=("$name")
  done <<<"$live"

  if [[ ${#matches[@]} -eq 0 ]]; then
    echo "No codersync sessions on ${SSH_TARGET}."
    return 0
  fi

  echo "This will kill ALL codersync sessions on ${SSH_TARGET}:"
  printf '  %s\n' "${matches[@]}"
  local reply
  read -r -p "Proceed? [y/N] " reply
  if [[ ! "$reply" =~ ^[Yy]$ ]]; then
    echo "Aborted."
    return 0
  fi

  # Held across the WHOLE kill (every remote_kill_session call below,
  # not just the final registry cleanup) -- NOT across the confirmation
  # prompt above, which waits on a human and could block a concurrent
  # invocation for however long that takes. Same reason as
  # kill_sessions holds it this wide: find_or_assign_id reuses an
  # existing row's raw text for a matching target+suffix, so a
  # brand-new `codersync <same-name>` invocation started right after a
  # kill but before this cleanup could re-claim -- and re-mark-pending,
  # or even fully recreate as live again -- the exact row this is about
  # to drop. Re-checking just the pending marker wouldn't cover the
  # "already alive again" case, so the lock covers the whole operation
  # instead: no such invocation can start writing until this releases
  # it (confirmed live: --kill-all left registry_bytes=0 with a fresh
  # pending marker for a row it had just dropped).
  acquire_id_lock || exit 1
  trap 'release_id_lock' EXIT

  local count=0
  local -a killed_pairs=()
  local prefix2
  for name in "${matches[@]}"; do
    echo "Killing: $name"
    remote_kill_session "$name"
    prefix2="$(session_prefix_for "$name")"
    parse_numbered_session "$prefix2" "$name"
    # Recorded as (id, rest) -- not the reconstructed raw string -- for
    # the same reason kill_sessions does: the matching registry entry's
    # raw text (e.g. a leading-zero ID like "08-...") can differ from
    # "${PARSED_ID}-${PARSED_REST}", so the cleanup below compares each
    # entry's OWN parsed (id, rest) instead of an exact string match.
    killed_pairs+=("${PARSED_ID}"$'\t'"${PARSED_REST}")
    count=$((count + 1))
  done

  touch "$REGISTRY"
  local kept=()
  local line kp drop
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    parse_registry_line "$line"
    drop=0
    if [[ "$ENTRY_TARGET" == "$SSH_TARGET" ]]; then
      parse_numbered_session "" "$ENTRY_NAME"
      for kp in "${killed_pairs[@]}"; do
        if [[ "$kp" == "${PARSED_ID}"$'\t'"${PARSED_REST}" ]]; then
          drop=1
          break
        fi
      done
    fi
    # Only entries matching a session actually just killed are dropped --
    # NOT every current-target entry unconditionally (the prior
    # behavior). That unconditional drop would also wipe out a
    # currently-in-flight creation's pending registry entry (see
    # mark_pending) and a legitimately-preserved "half-alive pair" entry
    # (see restore_all's own "only one of claude/codex is still alive"
    # branch), neither of which this run actually killed.
    [[ "$drop" == 0 ]] && kept+=("$line")
  done < "$REGISTRY"
  if [[ ${#kept[@]} -gt 0 ]]; then
    printf '%s\n' "${kept[@]}" > "$REGISTRY"
  else
    : > "$REGISTRY"
  fi
  trap - EXIT
  release_id_lock

  echo "Killed ${count} session(s)."
}

# `codersync --paste-image` -- lets you get an image from your LOCAL
# clipboard into a claude/codex session running on the remote box.
#
# Claude Code (and most CLI agents) read the clipboard by shelling out
# to a LOCAL utility (pbpaste on macOS, xclip/wl-paste on Linux) on
# whatever machine the process is actually running on. Since the whole
# point of codersync is running that process on the REMOTE box, a plain
# Cmd+V there tries to read the REMOTE box's clipboard -- empty, no
# display server -- not your Mac's, where the image actually is. tmux
# makes it worse on top of that (it only forwards text on paste, not
# binary image data), but even bypassing tmux entirely, the core
# cross-machine clipboard problem remains.
#
# This sidesteps that instead of trying to solve live binary clipboard
# forwarding: it uploads the clipboard image to the remote box as a
# real file and puts that file's PATH (plain text) on your LOCAL
# clipboard, so your next ordinary Cmd+V into the session pastes a path
# claude/codex can read normally -- no binary data crosses the
# ssh/tmux boundary at all, so there's nothing for tmux to mangle.
#
# Reads the clipboard via osascript's `the clipboard as «class PNGf»`
# -- macOS-native, no extra dependency, consistent with how
# iterm2_available()/open_tab() already shell out to osascript for
# iTerm2 automation. The image is then base64-encoded locally and sent
# through the SAME ssh/heredoc/`set -C`/`umask 077` mechanism already
# used for launch scripts (see remote_setup's comment) -- not `scp` --
# so it gets the same symlink-pre-plant and world-readable-until-cleaned
# protections as everything else this tool writes to remote /tmp,
# without introducing a second remote-write code path to keep in sync.
#
# The clipboard content (a screenshot, a copied image -- potentially
# sensitive) briefly touches local disk at $local_tmp before upload.
# `umask 077` (set BEFORE osascript creates the file, so the child
# process inherits it) keeps it from being merely world-readable;
# `trap ... EXIT`, armed right after -- before anything can fail --
# covers the window between then and the point where its content is
# safely captured in $encoded (a failure in `wc`, `base64`, or the
# local user hitting Ctrl-C used to skip straight past the `rm -f`
# calls this used to scatter across each early-exit branch, leaving
# the file behind under this script's `set -e`). Once $encoded exists,
# $local_tmp is cleaned up and the trap explicitly disarmed right there
# -- NOT left for the trap to catch later: by the time it would
# otherwise fire (this function has returned, and the dispatch case
# that called it does `exit 0`), `local_tmp`'s `local` binding no
# longer exists, and referencing it in the trap at that point is
# itself a fatal error under this script's `set -u` (confirmed live).
paste_image() {
  local local_tmp
  local_tmp="/tmp/codersync-clip-$(random_suffix).png"
  trap 'rm -f -- "$local_tmp"' EXIT
  umask 077
  if ! osascript -e "
    try
      set imgData to the clipboard as «class PNGf»
    on error
      error \"codersync: no image found on the clipboard\"
    end try
    set fp to open for access (POSIX file \"${local_tmp}\") with write permission
    set eof fp to 0
    write imgData to fp
    close access fp
  " >/dev/null 2>&1; then
    echo "codersync: no image found on the clipboard -- copy a screenshot or image first." >&2
    exit 1
  fi

  # Sanity cap, not a hard technical limit: this all goes through a
  # local bash variable and a heredoc (see below), both of which handle
  # multi-MB values fine, but a huge value here is almost certainly a
  # mistake (the wrong thing copied) rather than an intentional paste.
  local max_bytes=$((25 * 1024 * 1024))
  local size
  size="$(wc -c < "$local_tmp" | tr -d ' ')"
  if (( size > max_bytes )); then
    echo "codersync: clipboard image is ${size} bytes -- larger than the ${max_bytes}-byte cap, aborting (probably not what you meant to paste)." >&2
    exit 1
  fi

  local remote_path
  remote_path="/tmp/codersync-img-$(random_suffix).png"
  local encoded
  encoded="$(base64 < "$local_tmp" | tr -d '\n')"
  # local_tmp's content is now fully captured in $encoded -- clean up
  # and disarm the trap HERE rather than leaving that to the trap alone:
  # by the time it would otherwise fire (at the dispatch case's `exit 0`,
  # after this function has already returned), `local_tmp`'s `local`
  # binding no longer exists, and referencing it under this script's
  # `set -u` at that point is itself a fatal error (confirmed live).
  rm -f -- "$local_tmp"
  trap - EXIT

  # shellcheck disable=SC2087 # intentional: local expansion is the
  # point -- ${encoded}/${remote_path} below are THIS script's
  # variables and must substitute before the heredoc is sent.
  if ! ssh "$SSH_TARGET" -- 'PATH="$HOME/.local/bin:$HOME/bin:$PATH" bash -s' <<EOF
set -e
set -C
umask 077
echo ${encoded} | base64 -d > ${remote_path}
EOF
  then
    echo "codersync: failed to upload the image to ${SSH_TARGET}." >&2
    exit 1
  fi

  # Checked explicitly, not left to this script's own `set -e` --
  # `pipefail` makes a pbcopy failure (no GUI session/pasteboard
  # access, pbcopy missing, whatever) abort the WHOLE pipeline's exit
  # status, which `set -e` then acts on immediately: the upload had
  # already succeeded by this point, but the two echoes below never
  # ran, so the only feedback the user got was silence -- no error, no
  # path, nothing to indicate the file exists at all (confirmed live).
  if ! printf '%s' "$remote_path" | pbcopy; then
    echo "codersync: uploaded to ${SSH_TARGET}:${remote_path}, but failed to copy that path to the local clipboard." >&2
    echo "$remote_path"
    exit 1
  fi

  echo "Uploaded to ${SSH_TARGET}:${remote_path}"
  echo "Paste (Cmd+V) into the session to insert the path."
}

# `codersync --sync-skills` -- copies locally-authored agent skills to
# the same path on the remote box, so a claude/codex session started
# there via codersync has the same skills a local session would.
#
# Only covers tools whose skills-directory convention has actually been
# confirmed against a real local install: claude (~/.claude/skills) and
# codex (~/.codex/skills). agy, aider, and kimi -- the other keys
# resolve_tool() knows about -- aren't installed on this machine to
# verify a convention against, and this tool doesn't guess unverified
# paths, same principle as resolve_tool()'s own comment on known-key
# flags being sourced and verified rather than assumed.
#
# ~/.codex/skills/.system ships bundled with Codex itself, not authored
# by the user -- excluded so this only ever copies skills the user
# actually created, not Codex's own default library (which already
# exists wherever Codex is installed on the remote box, with no help
# from this tool).
#
# Uses rsync rather than the base64/heredoc mechanism the rest of this
# tool uses for single files: a skills directory is an arbitrary tree
# of files, and rsync already handles that -- plus incremental re-syncs
# after a local edit -- correctly. Reinventing that over a heredoc would
# just be a worse rsync. No --delete: a skill that only exists on the
# remote box is left alone rather than silently removed.
sync_skills() {
  # Discovery happens BEFORE either rsync check below, and the function
  # returns early if there's nothing to sync -- otherwise a machine with
  # no local skills for any known tool (or only ~/.codex/skills/.system,
  # which never counts) would report a misleading "rsync isn't
  # installed on <target>" if the remote box happens to lack rsync,
  # instead of the intended no-op message, even though rsync would
  # never actually have been needed.
  local sync_claude=0 sync_codex=0

  if [[ -d "$HOME/.claude/skills" ]] &&
     find "$HOME/.claude/skills" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null | grep -q .; then
    sync_claude=1
  fi

  if [[ -d "$HOME/.codex/skills" ]] &&
     find "$HOME/.codex/skills" -mindepth 1 -maxdepth 1 ! -name '.system' -print -quit 2>/dev/null | grep -q .; then
    sync_codex=1
  fi

  if [[ "$sync_claude" -eq 0 && "$sync_codex" -eq 0 ]]; then
    echo "No locally-authored skills found for any supported tool (checked: claude, codex)."
    return
  fi

  echo "Checking rsync is available locally..."
  if ! command -v rsync >/dev/null 2>&1; then
    echo "codersync: rsync isn't installed locally. Install it (e.g. 'brew install rsync') and try again." >&2
    exit 1
  fi

  echo "Checking rsync is available on ${SSH_TARGET}..."
  # PATH-prefixed for the same reason as setup()'s tmux/bash checks: a
  # non-interactive `ssh ... command -v` doesn't source
  # ~/.bashrc/~/.profile, so rsync installed only under e.g. ~/.local/bin
  # would otherwise report as missing here.
  if ! ssh "$SSH_TARGET" -- 'PATH="$HOME/.local/bin:$HOME/bin:$PATH" command -v rsync' >/dev/null 2>&1; then
    echo "codersync: rsync isn't installed on ${SSH_TARGET}. Install it there (e.g. 'sudo apt install rsync') and re-run --sync-skills." >&2
    exit 1
  fi

  if [[ "$sync_claude" -eq 1 ]]; then
    echo "Syncing claude skills (~/.claude/skills) to ${SSH_TARGET}..."
    if ! rsync -az "$HOME/.claude/skills/" "${SSH_TARGET}:.claude/skills/"; then
      echo "codersync: failed to sync claude skills to ${SSH_TARGET}." >&2
      exit 1
    fi
  fi

  if [[ "$sync_codex" -eq 1 ]]; then
    echo "Syncing codex skills (~/.codex/skills) to ${SSH_TARGET}..."
    if ! rsync -az --exclude='.system' "$HOME/.codex/skills/" "${SSH_TARGET}:.codex/skills/"; then
      echo "codersync: failed to sync codex skills to ${SSH_TARGET}." >&2
      exit 1
    fi
  fi
}

# `codersync --local|-L <session-name> [--tools|-t t1,t2] [--safe-mode|-s]`
# -- creates (or reattaches to) a two-pane tmux session directly on
# THIS machine, no ssh involved at all. Meant to be run by hand after
# you've already SSH'd into the remote box yourself (codersync
# installed on both ends), so you can start working immediately
# without waiting for a client machine to drive the setup. Detach
# whenever (Ctrl-b d, ordinary tmux) -- `codersync --adopt`, run later
# from a client machine pointed at this box, picks it up so
# --list-all/--attach/--rename/--kill all work on it normally from
# there too.
#
# Deliberately named WITHOUT a target-label or numeric-ID prefix (just
# "pair-<name>", the same shape a pre-numbering legacy session has).
# ID allocation is otherwise a per-client-machine sequence
# (~/.config/codersync/next_id), and this box has no way to know what
# alias a client will someday refer to it by, so there's no safe label
# to bake in up front either. resolve_registered_session's name lookup
# already falls back to matching a rest with no label prefix at all
# specifically so a session created this way is still reachable by
# plain name once adopted.
#
# Always the tmux-split shape (one session, two panes) -- iterm split
# mode is inherently Mac+iTerm2-driven and meaningless to invoke
# directly on the remote box itself, so there's no --split-mode here.
local_setup() {
  local name="$1"
  shift
  if ! validate_session_name "$name"; then
    echo "Invalid session name '${name}': only letters, digits, '-', and '_' are allowed, and it can't start with '-'." >&2
    exit 1
  fi
  # Rejected for the same reason rename_session rejects a purely-
  # numeric new name: --attach/--kill always read a numeric argument as
  # an ID, never a name, and a --local session has no ID of its own to
  # fall back to (it's deliberately created label-less, see this
  # function's own comment) -- so a session named this way would be
  # permanently unaddressable by name (and unaddressable by ID, since
  # it was never assigned one) once adopted.
  if [[ "$name" =~ ^[0-9]+$ ]]; then
    echo "codersync: '${name}' can't be a plain number -- --attach/--kill always read a numeric argument as an ID, never a name, and a --local session has no ID to fall back to." >&2
    exit 1
  fi

  local tools="claude,codex" safe=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --tools|-t)
        if [[ $# -lt 2 || "$2" == -* ]]; then
          echo "--tools/-t requires a value (e.g. claude,codex)" >&2
          exit 1
        fi
        tools="$2"
        shift 2
        ;;
      --safe-mode|-s)
        safe=1
        shift
        ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 1
        ;;
    esac
  done
  split_tools "$tools"
  if ! tools_split_is_valid "$tools"; then
    echo "codersync: --tools '${tools}' is malformed -- expected two comma-separated values (e.g. claude,codex) or a single value to use for both: no empty slot on either side of the comma, and no more than one comma total." >&2
    exit 1
  fi
  local tool1="$TOOL1" tool2="$TOOL2"

  local pair_tmux="pair-${name}"

  # Idempotent, same as the normal client-driven creation path: re-running
  # with the same name reattaches to what's already there instead of
  # erroring or creating a duplicate.
  if tmux has-session -t "$pair_tmux" 2>/dev/null; then
    echo "Reattaching to existing local session '${name}'..."
    exec tmux attach -t "$pair_tmux"
  fi

  local cmd1 cmd2 bin1 bin2
  cmd1="$(resolve_tool "$tool1" "$name" "$safe")"
  cmd2="$(resolve_tool "$tool2" "$name" "$safe")"
  bin1="$(command_word_for "$cmd1")"
  bin2="$(command_word_for "$cmd2")"

  local missing=""
  command -v "$bin1" >/dev/null 2>&1 || missing="${missing} ${bin1}"
  command -v "$bin2" >/dev/null 2>&1 || missing="${missing} ${bin2}"
  if [[ -n "$missing" ]]; then
    echo "codersync: not found on $(hostname):${missing}" >&2
    exit 1
  fi

  local script1 script2
  script1="/tmp/codersync-${pair_tmux}-0-$(random_suffix).sh"
  script2="/tmp/codersync-${pair_tmux}-1-$(random_suffix).sh"
  # `set -C`/`umask 077` scoped to a subshell each, same protections the
  # remote heredoc path uses (random filenames + noclobber stop another
  # local user from planting/clobbering the file; umask keeps a
  # --tools value containing its own secret from being world-readable),
  # just without leaking either setting into the rest of this function.
  # shellcheck disable=SC2016 # intentional: '$0' is meant to stay
  # literal here -- it's evaluated later, by the script itself when
  # `bash $script1`/`bash $script2` actually run it, not now.
  if ! (umask 077; set -C; { echo 'rm -f -- "$0"'; printf '%s\n' "$cmd1"; } > "$script1") ||
     ! (umask 077; set -C; { echo 'rm -f -- "$0"'; printf '%s\n' "$cmd2"; } > "$script2"); then
    echo "codersync: failed to write local launch scripts for '${name}'." >&2
    rm -f -- "$script1" "$script2"
    exit 1
  fi

  local dir="$PWD"
  # The cleanup trap is armed ONLY after `tmux new-session` has
  # actually succeeded, never before -- the earlier `tmux has-session`
  # check above and this call aren't atomic, so another invocation
  # could win a race and create "$pair_tmux" in between. If that
  # happens, `new-session` here fails (this script's own `set -e`,
  # active globally, would otherwise exit right here anyway), and
  # since the trap was never armed, nothing kills the session the
  # OTHER process just legitimately created. Confirmed live with a
  # stubbed tmux: arming the trap before this call let exactly that
  # race kill an unrelated, already-existing session under the same
  # name.
  if ! tmux new-session -d -s "$pair_tmux" -c "$dir"; then
    echo "codersync: couldn't create local session '${pair_tmux}' -- it may have just been created by another invocation. Try again, or attach directly with: tmux attach -t ${pair_tmux}" >&2
    rm -f -- "$script1" "$script2"
    exit 1
  fi
  # Double-quoted, not single-quoted -- bakes the CURRENT values of
  # $pair_tmux/$script1/$script2 into the trap's command text literally,
  # right now, rather than leaving `$variable` references to be resolved
  # later, when the trap actually fires. Bash runs an EXIT trap only
  # after the function that armed it has already returned and its own
  # `local` variables have gone out of scope -- confirmed directly: a
  # single-quoted version of this exact trap, fired by a later command
  # failing under this script's own `set -e`, crashed with "unbound
  # variable" instead of ever running its kill-session/rm at all,
  # since by fire time $pair_tmux itself no longer existed to expand.
  # All three values are already known-safe (validate_session_name'd,
  # or built from validated components plus random_suffix's safe
  # charset), so baking them in as literal text here isn't a quoting
  # hazard the way it would be for arbitrary/untrusted input.
  # shellcheck disable=SC2064 # intentional: expanding NOW, not at
  # signal time, is the entire point -- see the comment above.
  trap "tmux kill-session -t \"$pair_tmux\" 2>/dev/null; rm -f -- \"$script1\" \"$script2\"" EXIT
  tmux split-window -h -t "$pair_tmux" -c "$dir"
  tmux send-keys -t "${pair_tmux}.0" "bash $script1" Enter
  tmux send-keys -t "${pair_tmux}.1" "bash $script2" Enter
  tmux set-option -t "$pair_tmux" status off
  trap - EXIT

  exec tmux attach -t "$pair_tmux"
}

# `codersync --adopt|-d` -- scans the currently configured target's
# live tmux sessions for anything matching codersync's own naming
# pattern (claude-/codex-/pair-, with or without a numeric ID) that
# ISN'T already in the local registry, and registers it. This is what
# makes `codersync --local` (see its own comment) useful from a client
# machine afterward: without this, a session created directly on the
# box is invisible to --list-all/--attach/--rename/--kill here, the
# same as any other unregistered live session.
#
# Mirrors list_all_sessions' own dedup logic (an iterm-split pair is
# TWO live tmux sessions for ONE logical entry) but inverted:
# registers whatever ISN'T yet owned, instead of displaying whatever
# already is.
adopt_sessions() {
  local live
  live="$(ssh "$SSH_TARGET" -- "tmux list-sessions -F '#{session_name}'" 2>/dev/null || true)"

  # Pre-pass: builds a flat "id:rest:kind:raw_rest" record for EVERY
  # live session (not just unregistered ones, and not deduped), so the
  # main loop below can cheaply check two things using CANONICAL
  # id/rest (so a leading-zero "pair-08-host-foo" and an
  # already-canonical "claude-8-host-foo" are correctly recognized as
  # related even though their raw text differs):
  #   1. whether a candidate's (id,rest) also shows up under the
  #      OPPOSITE kind (an unrelated tmux-mode/iterm-mode session
  #      sharing the same canonical identity)
  #   2. whether MULTIPLE DISTINCT raw names map to the exact same
  #      (id,rest,kind) -- e.g. "claude-08-host-foo" alongside
  #      "codex-8-host-foo" (same canonical id, but disagreeing raw
  #      text -- the normal claude-X/codex-X pair has IDENTICAL raw
  #      text on both sides, so this only fires when something's
  #      actually wrong), or two separate live "pair-" sessions
  #      ("pair-08-host-foo" and "pair-8-host-foo") that happen to
  #      canonicalize to the same id/rest despite being two genuinely
  #      different sessions.
  # Cheap: the number of live sessions on a box is always small.
  local all_keys=$'\n'
  local pre_line pre_prefix pre_kind pre_raw
  while IFS= read -r pre_line; do
    [[ -z "$pre_line" ]] && continue
    pre_prefix="$(session_prefix_for "$pre_line")" || continue
    pre_kind="iterm"
    [[ "$pre_prefix" == "pair-" ]] && pre_kind="tmux"
    parse_numbered_session "$pre_prefix" "$pre_line"
    pre_raw="${pre_line#"$pre_prefix"}"
    all_keys+="${PARSED_ID}:${PARSED_REST}:${pre_kind}:${pre_raw}"$'\n'
  done <<<"$live"

  local seen_keys=$'\n'
  local -a to_adopt=() to_adopt_ids=()
  local line prefix kind key live_id live_rest raw_rest other_kind
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    prefix="$(session_prefix_for "$line")" || continue
    kind="iterm"
    [[ "$prefix" == "pair-" ]] && kind="tmux"
    parse_numbered_session "$prefix" "$line"
    live_id="$PARSED_ID"
    live_rest="$PARSED_REST"
    raw_rest="${line#"$prefix"}"
    # Checked by RAW text, same as every other session_is_owned call
    # site -- see that function's own comment for why (canonical id/rest
    # matching alone let an unrelated, never-registered live session
    # with different raw text but the same canonical value get treated
    # as owned). This is ALSO exactly the case adopt_sessions cares
    # about most: a live session with different raw text than any
    # existing registry entry is, by definition, not yet adopted, and
    # should proceed to the checks below rather than being skipped as
    # "already owned."
    session_is_owned "$raw_rest" && continue
    key="${kind}:${live_id}:${live_rest}"
    case "$seen_keys" in
      *$'\n'"$key"$'\n'*) continue ;;
    esac
    seen_keys+="$key"$'\n'
    # An iterm-mode candidate is only a genuine, complete split pair if
    # its OTHER half is ALSO live under the exact same raw text -- a
    # real codersync-created iterm session always creates claude-X and
    # codex-X together (remote_setup's own all-or-nothing rollback
    # never leaves just one behind on a FRESH create), so a lone
    # claude-X or codex-X with no counterpart at all is either the
    # surviving half of a pair whose other side was killed separately,
    # or an unrelated live session that merely happens to start with
    # "claude-"/"codex-". Registering it anyway made --adopt report
    # success for something --attach immediately refused as "only one
    # side alive" (confirmed live), and made it trivial to accidentally
    # pull an unrelated claude-*/codex-* session into the registry.
    if [[ "$kind" == "iterm" ]]; then
      local other_prefix="codex-"
      [[ "$prefix" == "codex-" ]] && other_prefix="claude-"
      if ! grep -qxF "${other_prefix}${raw_rest}" <<<"$live"; then
        echo "codersync: skipping '${prefix}${raw_rest}' -- no matching '${other_prefix}${raw_rest}' counterpart is alive on ${SSH_TARGET}, so this isn't a complete iterm-split pair." >&2
        continue
      fi
    fi
    # entry_name is the RAW post-prefix text, not reconstructed from
    # the CANONICALIZED live_id -- a live "pair-08-host-foo" canonicalizes
    # to id=8 (leading zero stripped), but the actual live tmux session
    # is still literally named "pair-08-host-foo". Registering the
    # reconstructed "8-host-foo" instead left every later lookup
    # (attach_session/rename_session grep the LIVE list for
    # "pair-8-host-foo", which never matches) reporting the
    # just-adopted session as "registered but not alive" -- exactly
    # the bug shape --kill's and --attach's own comments already
    # describe and avoid the same way (confirmed live). live_id is
    # still used below for bump_next_id_past and the dedup key above,
    # both of which genuinely need the canonical numeric value.
    local entry_name="$raw_rest"
    # A raw post-prefix segment that LOOKS like an ID attempt but fails
    # canonicalization (e.g. "0-host-foo", or a pathologically long
    # digit run) is poisoned -- the exact shape session_is_owned() and
    # restore_all already refuse to trust anywhere else. Skipped here
    # too, rather than adopted: registering it made --adopt report
    # success for a session that was never actually made manageable,
    # since every ownership check that matters (session_is_owned,
    # find_or_assign_id) already treats that shape as unauthorized.
    if [[ "$entry_name" =~ ^([0-9]+)-(.*)$ ]] && ! canonicalize_session_id "${BASH_REMATCH[1]}" >/dev/null; then
      echo "codersync: skipping poisoned live session name (invalid ID segment): ${prefix}${entry_name}" >&2
      continue
    fi
    # entry_name is built from a LIVE tmux session name, not something
    # this tool already validated at creation time -- a hand-created
    # or otherwise poisoned live session (e.g. "pair-x;touch /tmp/pwn")
    # would otherwise be written straight into the registry, which
    # every other write path (register_session's own callers) already
    # only ever does with pre-validated values. Same defense restore_all
    # applies to registry entries it's about to keep, applied here to a
    # live tmux name instead (confirmed live: "pair-x;touch /tmp/pwn"
    # got adopted verbatim as "x;touch /tmp/pwn" before this check).
    if ! validate_session_name "$entry_name"; then
      echo "codersync: skipping unsafe live session name (contains characters outside a-z/0-9/_/- ): ${prefix}${entry_name}" >&2
      continue
    fi
    # Ownership (session_is_owned) matches on raw post-prefix text
    # alone, with no notion of WHICH prefix (pair- vs claude-/codex-) a
    # live session actually uses -- the same gap --rename's own
    # preflight check already guards against for renaming. Adopting
    # one of two
    # DIFFERENT live sessions (a tmux-mode "pair-X" and an unrelated
    # iterm-mode "claude-X"/"codex-X" pair sharing the same id/rest,
    # once canonicalized) would register a SINGLE entry that then
    # satisfies ownership for BOTH, silently merging two unrelated
    # sessions into one logical identity (confirmed live). Refused
    # outright here rather than guessing which one the user meant.
    other_kind="tmux"
    [[ "$kind" == "tmux" ]] && other_kind="iterm"
    if [[ "$all_keys" == *$'\n'"${live_id}:${live_rest}:${other_kind}:"* ]]; then
      echo "codersync: skipping '${prefix}${raw_rest}' -- an unrelated ${other_kind} session shares the same id/rest on ${SSH_TARGET}, and adopting either would make --list-all/--attach/--kill treat them as the same session. Rename one of them first (plain tmux rename-session), then re-run --adopt." >&2
      continue
    fi
    # Same underlying ambiguity as the cross-kind check above, but
    # within the SAME kind: multiple DISTINCT raw names can still
    # canonicalize to this exact (id,rest,kind) -- either two separate
    # live "pair-" sessions that happen to collide once canonicalized
    # (tmux kind), or a claude-X/codex-X pair whose two sides disagree
    # on raw formatting entirely (iterm kind; the NORMAL pair has
    # IDENTICAL raw text on both sides, so this never fires for a
    # correctly-matching pair). Registering just one of them anyway
    # left the other permanently unaddressed by that raw text while
    # STILL satisfying ownership for it (canonical id/rest matching
    # doesn't care about raw text either) -- --attach reported a
    # correctly-live pair as "half dead", and --kill on the shared ID
    # killed a live tmux-mode session that was never actually adopted
    # (confirmed live).
    local prefix_key="${live_id}:${live_rest}:${kind}:"
    local -a distinct_raws=()
    local ak araw already existing
    while IFS= read -r ak; do
      case "$ak" in
        "$prefix_key"*)
          araw="${ak#"$prefix_key"}"
          already=0
          # Guarded on length before expanding "${distinct_raws[@]}" --
          # macOS ships bash 3.2 as /bin/bash (see b64()'s neighboring
          # comment for the same constraint elsewhere in this file),
          # and expanding an EMPTY array this way is a fatal "unbound
          # variable" under this script's own `set -u` on that version
          # (confirmed directly against /bin/bash 3.2; bash 4.4+ fixed
          # this specific case, but this file doesn't assume 4.4+).
          if [[ ${#distinct_raws[@]} -gt 0 ]]; then
            for existing in "${distinct_raws[@]}"; do
              [[ "$existing" == "$araw" ]] && { already=1; break; }
            done
          fi
          [[ "$already" == 0 ]] && distinct_raws+=("$araw")
          ;;
      esac
    done <<<"$all_keys"
    if [[ ${#distinct_raws[@]} -gt 1 ]]; then
      echo "codersync: skipping '${prefix}${raw_rest}' -- multiple live sessions with different raw names canonicalize to the same id/rest on ${SSH_TARGET}: ${distinct_raws[*]}. Rename one of them first (plain tmux rename-session) so they agree, then re-run --adopt." >&2
      continue
    fi
    to_adopt+=("$entry_name")
    to_adopt_ids+=("$live_id")
  done <<<"$live"

  if [[ ${#to_adopt[@]} -eq 0 ]]; then
    echo "Nothing new to adopt on ${SSH_TARGET}."
    return 0
  fi

  # Locked the same way the normal creation path and rename_session
  # lock their own registry/next_id mutations -- register_session and
  # bump_next_id_past below both touch state a concurrent `codersync
  # <name>` invocation reads/writes too.
  acquire_id_lock || exit 1
  trap 'release_id_lock' EXIT
  local i name id
  for ((i = 0; i < ${#to_adopt[@]}; i++)); do
    name="${to_adopt[$i]}"
    id="${to_adopt_ids[$i]}"
    register_session "$name"
    # Preserves this live session's own numeric ID as-is (never
    # renumbered -- it's already baked into the literal tmux session
    # name), but ensures THIS client's own next_session_id() counter
    # can never re-mint it for something else afterward. Without this,
    # a client whose counter was still behind (e.g. its default of 1)
    # adopted a live "pair-1-host-foo" and then minted ID 1 again on
    # the very next `codersync <name>` -- two registry entries for the
    # same target both claiming ID 1, which --list-all showed as a
    # duplicate and --kill 1 matched both (confirmed live/reproduced
    # with a stub).
    [[ -n "$id" ]] && bump_next_id_past "$id"
    echo "Adopted: $name"
  done
  trap - EXIT
  release_id_lock
}

print_help() {
  cat <<'HELP'
Usage:
  codersync --setup|-s <ssh-target> [remote-dir]            One-time setup
  codersync <session-name> [--split-mode|-m iterm|tmux] [--tools|-t t1,t2] [--safe-mode|-s]
                                                             Open a tab
  codersync --attach|-a <id-or-name>                        Reconnect to one existing session
  codersync --rename|-R <id-or-name> <new-name>             Rename one existing session
  codersync --restore-all|-r                                Reopen all live sessions
  codersync --list-all|-l                                   List live sessions with their IDs
  codersync --kill|-k <ids>                                 Kill sessions by ID (e.g. 1,2,4 or 1-4)
  codersync --kill-all|-K                                   Kill every codersync session (asks to confirm)
  codersync --paste-image|-p                                Upload a clipboard image, copy its remote path
  codersync --sync-skills|-y                                Copy local claude/codex skills to the remote box
  codersync --local|-L <session-name>                       Start a session directly on this machine, no ssh
  codersync --adopt|-d                                      Register sessions started via --local into this registry
  codersync --help|-h                                       Show this help

<ssh-target> is a hostname, user@host, or an alias from ~/.ssh/config --
restricted to letters, digits, and . _ - @ (narrower than everything ssh
itself accepts; use a ~/.ssh/config Host alias for anything more exotic,
like a custom port or an IPv6 address). It's also used as the
session-name prefix, so `codersync foo` on target `devbox.example.com` opens a
tab and tmux sessions named `devbox-example-com-foo`.

Every session also gets a leading numeric ID (e.g. `1-devbox-example-com-foo`),
shown by --list-all/-l and used by --kill/-k -- a short handle so you don't
have to type the full name to look up or kill a session. Re-running
`codersync foo` reuses foo's existing ID rather than minting a new one.

Every flag below has the single-letter short form shown next to it.
--setup/-s and --safe-mode/-s deliberately share the letter "s" -- they're
parsed in two entirely separate contexts (top-level dispatch decides
--setup-vs-a-session-name first; --safe-mode only exists within a
session-name invocation's own options), so there's no ambiguity in
practice, only in a skim of this text.

--split-mode/-m tmux (default): one tmux session with two panes split
server-side, and the local side just opens a tab and attaches once. Uses
iTerm2 to open that tab when it's installed, but doesn't require it --
without iTerm2, prints the attach command to run yourself in any
terminal instead.
--split-mode/-m iterm: two separate tmux sessions, split locally by iTerm2
-- lets you attach to just the left or right pane separately, but
requires iTerm2 (no fallback for this mode).

--tools/-t t1,t2 (default: claude,codex): which two CLI agents run left/
right. Known keys (auto-append that tool's skip-approval flag):
  claude  claude --dangerously-skip-permissions -n <session>
  codex   codex --dangerously-bypass-approvals-and-sandbox -s danger-full-access
  agy     agy --dangerously-skip-permissions (Antigravity CLI, was Gemini CLI)
  aider   aider --yes-always
  kimi    kimi --yolo
Anything else is run as a literal command, so any CLI agent works even
without a short key -- give the exact command including its own
skip-approval flag, e.g. `-t claude,'some-agent --some-flag'`. Same
tool twice also works: `-t claude,claude`. A literal command
can't contain a comma, though (it's the t1/t2 separator, with no
escaping) -- `-t 'agent --model a,b'` splits into two tools at
that comma rather than one tool with a comma in its flag. Exactly one
comma (or zero) is required either way; `-t claude,codex,aider`
is rejected outright rather than silently dropping the third.

--safe-mode/-s: drop the auto-approve flag for known --tools/-t keys, so
normal permission prompts apply instead. Only affects known keys -- for
a raw/literal --tools/-t command, just leave its skip-approval flag out.

--attach/-a <id-or-name>: reconnects to ONE specific existing session, by
its numeric ID (see --list-all/-l) or its plain name (what you typed to
`codersync <name>` originally, without the target-label/ID prefixing).
Unlike plain `codersync <name>`, which creates a session if it doesn't
already exist, this errors instead -- so a typo can't accidentally spin
up a brand-new paired session when you meant to reconnect to an old
one. A purely-numeric argument is always read as an ID, never as a
literal name (same precedent as --kill/-k). Registry-scoped, same as
--list-all/-l/--kill/-k/--kill-all/-K.

--rename/-R <id-or-name> <new-name>: renames one existing session
(looked up the same way as --attach/-a) to a new plain name, keeping
its numeric ID unchanged. Just renames the live tmux session(s) --
whatever's running inside is untouched, not restarted. <new-name>
can't be a plain number either, for the same reason a bare number is
never read as a name: it would make the session unreachable by name
afterward. Gets capital -R since lowercase -r is already taken by
--restore-all.

--list-all/-l: queries the current target's live tmux sessions and prints
each one's ID, split mode, and name -- for sessions both alive on the
box AND recorded in the local registry (~/.codersync_sessions); a live
session missing from the registry (different machine, cleared
registry) won't show up here. Sessions from before this ID scheme
existed still show up, with a "-" in the ID column (they can't be
targeted by --kill/-k; kill them with --kill-all/-K or plain tmux instead).

--kill/-k <ids>: kills every session matching any ID in <ids> and removes
it from the local registry. Accepts a comma-separated list ("1,2,4"), a
range ("1-4"), or a mix ("1,3-5,8"). An ID with no live match is
reported and skipped rather than aborting the rest of the list.

--kill-all/-K: kills every codersync session on the current target
(including legacy ones with no numeric ID) and clears the local
registry for it. Prints the full list and asks for a y/N confirmation
first, since there's no undo for picking the wrong box. Capital -K
(not lowercase -k, which is the narrower --kill) so the two aren't a
one-character-case typo away from each other for something this
destructive.

--paste-image/-p: uploads whatever image is on your LOCAL clipboard to
the current target as a real file, then replaces your clipboard
content with that file's remote path (plain text) instead of the
image. claude/codex read the clipboard on whatever machine they're
actually running on -- the remote box, not your Mac -- so a plain
Cmd+V there can't reach an image sitting on your local clipboard at
all. Pasting the resulting path afterward is just ordinary text, so it
goes through ssh/tmux exactly like any other paste. Fails clearly if
there's no image on the clipboard, or if it's larger than 25MB
(almost certainly the wrong thing was copied).

--sync-skills/-y: rsyncs locally-authored agent skills to the same path
on the current target -- ~/.claude/skills for claude, ~/.codex/skills
for codex (excluding ~/.codex/skills/.system, which ships bundled with
Codex itself rather than being something you wrote). Only these two
tools are covered -- agy, aider, and kimi have no confirmed
skills-directory convention to sync against. A tool with nothing local
to sync is skipped, not treated as an error. Re-run any time after
adding or editing a skill locally; already-synced files are skipped.

--local/-L <session-name> [--tools/-t t1,t2] [--safe-mode/-s]: creates
(or reattaches to) a two-pane tmux session directly on THIS machine --
no ssh at all. Meant to be run by hand after you've already SSH'd into
the remote box yourself (codersync installed on both ends), so you can
start working immediately without waiting for a client machine to
drive the setup. Detach whenever with ordinary tmux (Ctrl-b d); see
--adopt/-d for picking it up from a client machine afterward. Always
the tmux-split shape (one session, two panes) -- there's no
--split-mode here, since iterm mode is inherently Mac+iTerm2-driven.
Session names created this way have no target-label or numeric-ID
prefix, unlike ones created the normal way.

--adopt/-d: scans the current target's live tmux sessions for anything
matching codersync's naming pattern that isn't already in this local
registry, and registers it. This is what makes --local/-L useful from
a client machine afterward -- without it, a session created directly
on the box is invisible to --list-all/--attach/--rename/--kill here,
same as any other unregistered live session.
HELP
}

# Strips leading/trailing whitespace. Portable to bash 3.2 (no
# extglob needed): `${s%%[![:space:]]*}` extracts the leading
# whitespace-only run, then `${s#"$that"}` removes exactly it; the
# trailing case is the mirror image.
trim_whitespace() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# Splits a "t1,t2" string into TOOL1/TOOL2 globals, trimming whitespace
# around each slot -- "claude, codex" (a space after the comma, a very
# natural way to type a list) otherwise left TOOL2 as " codex": that
# leading space made command_word_for read an empty executable word,
# so setup failed despite " codex" being a perfectly valid shell
# command once actually run. The mirror case ("claude ,codex") left
# TOOL1 as "claude " -- resolve_tool's case-statement match is exact,
# so that missed the known `claude` key entirely and silently fell
# through to running the literal, un-flagged text "claude " instead
# (confirmed live for both).
#
# Pulled out as its own function so it's unit-testable in isolation.
# Deliberately permissive on its own -- a single value with no comma
# fills BOTH slots with it (intentional; see resolve_tool's own comment
# on using the same tool twice), but that means an empty slot (from
# "aider," / ",aider" / "," / an explicitly empty value) also splits
# mechanically without complaint. See tools_split_is_valid() for the
# actual rejection of that case -- kept as a separate check rather than
# folded in here, so the "single value fills both slots" behavior stays
# unambiguously intentional rather than looking like an input-validation
# oversight.
split_tools() {
  local tools="$1"
  TOOL1="$(trim_whitespace "${tools%%,*}")"
  TOOL2="$(trim_whitespace "${tools#*,}")"
}

# True if split_tools() produced two real (non-empty) values from
# `tools` AND `tools` doesn't have more than one comma in the first
# place. Takes the raw pre-split value (not just TOOL1/TOOL2) because
# the second check can't be reconstructed from the split result alone:
# split_tools only ever considers the FIRST comma, so
# "claude,codex,aider" already silently became TOOL1=claude,
# TOOL2="codex,aider" by the time this runs -- an extra comma (a typo,
# or an attempt to pass a third agent, which codersync doesn't support;
# it only ever runs two, left and right) surfaced later as a confusing
# "not found" for the literal text "codex,aider" instead of a clear
# error about the actual problem.
#
# An empty slot ("aider," / ",aider" / "," / an explicitly empty value)
# used to silently reach remote_setup/remote_setup_tmux_mode as an
# empty tool1/tool2, which bash's `${2:-claude}`/`${3:-codex}` then
# defaulted the exact same way a genuinely UNSET argument would (`:-`
# treats empty and unset identically) -- so `--tools aider,` quietly
# launched aider plus the DEFAULT codex, dangerous-mode flag and all
# unless --safe-mode was also given. That's a real blast-radius
# difference from what was typed, not a cosmetic typo (confirmed live).
#
# NOT checked, and not checkable here: a literal command with its own
# comma (e.g. "agent --model a,b") is indistinguishable from valid
# "tool1,tool2" syntax at exactly one comma -- there's no way to tell
# "the user meant this comma as a literal character" from "the user
# meant this as the field separator" without new escaping syntax this
# tool doesn't have. README's Supported tools section documents that a
# literal command can't contain a comma, full stop.
tools_split_is_valid() {
  local tools="$1"
  [[ -n "$TOOL1" && -n "$TOOL2" ]] || return 1
  local without_commas="${tools//,/}"
  (( ${#tools} - ${#without_commas} <= 1 ))
}

# Parses the arguments to `codersync <session-name> [options...]`. Sets
# RAW_NAME/SPLIT_MODE/TOOLS/SAFE_MODE globals; exits 1 with a message on
# bad input. Pulled out as its own function so it's unit-testable via
# bats' `run` without going through the full dispatch/network calls.
parse_run_args() {
  RAW_NAME="$1"
  if ! validate_session_name "$RAW_NAME"; then
    echo "Invalid session name '${RAW_NAME}': only letters, digits, '-', and '_' are allowed, and it can't start with '-' (if you meant to pass a flag, check it's spelled right and comes with a session name)." >&2
    exit 1
  fi
  shift
  SPLIT_MODE="tmux"
  TOOLS="claude,codex"
  SAFE_MODE=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --split-mode|-m)
        # Checked explicitly rather than just `${2:-tmux}`: with that
        # alone, `--tools --safe-mode` silently consumed --safe-mode as
        # --tools' own value (TOOLS became the literal string
        # "--safe-mode", SAFE_MODE stayed 0) instead of erroring, and a
        # flag as the very last argument with no value at all failed via
        # `shift 2`'s own error rather than this function's message.
        # `-*` (not just `--*`) so this also catches a short flag in the
        # value slot, e.g. `--tools -s` -- the exact same swallowing bug,
        # just with the short form instead of the long one.
        if [[ $# -lt 2 || "$2" == -* ]]; then
          echo "--split-mode/-m requires a value (iterm or tmux)" >&2
          exit 1
        fi
        SPLIT_MODE="$2"
        shift 2
        ;;
      --tools|-t)
        if [[ $# -lt 2 || "$2" == -* ]]; then
          echo "--tools/-t requires a value (e.g. claude,codex)" >&2
          exit 1
        fi
        TOOLS="$2"
        shift 2
        ;;
      --safe-mode|-s)
        SAFE_MODE=1
        shift
        ;;
      *)
        echo "Unknown argument: $1" >&2
        exit 1
        ;;
    esac
  done
  if [[ "$SPLIT_MODE" != "iterm" && "$SPLIT_MODE" != "tmux" ]]; then
    echo "--split-mode must be 'iterm' or 'tmux', got: $SPLIT_MODE" >&2
    exit 1
  fi
}

# Guarded so the tests (tests/*.bats) can `source` this file to test the
# functions above in isolation without actually running the CLI dispatch.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
case "${1:-}" in
  --setup|-s)
    # This mutates local config, so an extra trailing argument (a typo'd
    # flag, an extra word) is rejected rather than silently ignored --
    # confirmed live, `codersync --setup host dir extra` used to just
    # drop "extra" with no warning at all.
    if [[ $# -gt 3 ]]; then
      echo "codersync: $1 takes at most 2 arguments (<ssh-target> [remote-dir]), got extra: ${*:4}" >&2
      exit 1
    fi
    setup "${2:-}" "${3:-}"
    exit 0
    ;;
  --restore-all|-r)
    # Opens tabs and rewrites the registry, so treated the same as the
    # other mutating commands above: an extra trailing argument is
    # rejected rather than silently ignored.
    if [[ $# -gt 1 ]]; then
      echo "codersync: $1 takes no arguments -- got extra: ${*:2}" >&2
      exit 1
    fi
    load_config
    restore_all
    exit 0
    ;;
  --attach|-a)
    if [[ -z "${2:-}" ]]; then
      echo "Usage: codersync --attach|-a <id-or-name> (e.g. --attach 3 or --attach my-feature)" >&2
      exit 1
    fi
    # Opens a tab, so treated the same as the other mutating commands
    # above: an extra trailing argument is rejected rather than silently
    # ignored. Checked before load_config, like every other arity check
    # here, so a malformed invocation never touches the network either.
    if [[ $# -gt 2 ]]; then
      echo "codersync: $1 takes exactly one argument (<id-or-name>) -- got extra: ${*:3}" >&2
      exit 1
    fi
    load_config
    attach_session "$2"
    exit 0
    ;;
  --rename|-R)
    if [[ -z "${2:-}" || -z "${3:-}" ]]; then
      echo "Usage: codersync --rename|-R <id-or-name> <new-name>" >&2
      exit 1
    fi
    # Renames a live tmux session and rewrites the registry, so treated
    # the same as the other mutating commands above: an extra trailing
    # argument is rejected rather than silently ignored. Checked before
    # load_config, like every other arity check here, so a malformed
    # invocation never touches the network either.
    if [[ $# -gt 3 ]]; then
      echo "codersync: $1 takes exactly two arguments (<id-or-name> <new-name>) -- got extra: ${*:4}" >&2
      exit 1
    fi
    load_config
    rename_session "$2" "$3"
    exit 0
    ;;
  --list-all|-l)
    if [[ $# -gt 1 ]]; then
      echo "codersync: $1 takes no arguments -- got extra: ${*:2}" >&2
      exit 1
    fi
    load_config
    list_all_sessions
    exit 0
    ;;
  --kill|-k)
    if [[ -z "${2:-}" ]]; then
      echo "Usage: codersync --kill|-k <ids> (e.g. --kill 1,2,4 or -k 1-4)" >&2
      exit 1
    fi
    # Kills remote sessions, so an extra trailing argument is rejected
    # rather than silently ignored -- confirmed live, `codersync --kill 1
    # 2` used to kill only ID 1 with no indication that "2" was dropped.
    # Checked before load_config (like every other arity check above),
    # so a malformed invocation never touches the network or any real
    # config either.
    if [[ $# -gt 2 ]]; then
      echo "codersync: $1 takes exactly one argument (<ids>, e.g. 1,2,4 or 1-4) -- got extra: ${*:3}" >&2
      exit 1
    fi
    load_config
    kill_sessions "$2"
    exit 0
    ;;
  --kill-all|-K)
    if [[ $# -gt 1 ]]; then
      echo "codersync: $1 takes no arguments -- got extra: ${*:2}" >&2
      exit 1
    fi
    load_config
    kill_all_sessions
    exit 0
    ;;
  --paste-image|-p)
    if [[ $# -gt 1 ]]; then
      echo "codersync: $1 takes no arguments -- got extra: ${*:2}" >&2
      exit 1
    fi
    load_config
    paste_image
    exit 0
    ;;
  --sync-skills|-y)
    if [[ $# -gt 1 ]]; then
      echo "codersync: $1 takes no arguments -- got extra: ${*:2}" >&2
      exit 1
    fi
    load_config
    sync_skills
    exit 0
    ;;
  --local|-L)
    # No load_config here -- local_setup never touches SSH_TARGET/
    # REMOTE_DIR at all, by design (see its own comment).
    if [[ -z "${2:-}" ]]; then
      echo "Usage: codersync --local|-L <session-name> [--tools|-t t1,t2] [--safe-mode|-s]" >&2
      exit 1
    fi
    shift
    local_setup "$@"
    exit 0
    ;;
  --adopt|-d)
    if [[ $# -gt 1 ]]; then
      echo "codersync: $1 takes no arguments -- got extra: ${*:2}" >&2
      exit 1
    fi
    load_config
    adopt_sessions
    exit 0
    ;;
  --help|-h)
    print_help
    exit 0
    ;;
  "")
    echo "Usage: codersync --setup|-s <ssh-target> [remote-dir] | codersync <session-name> | codersync --attach|-a <id-or-name> | codersync --rename|-R <id-or-name> <new-name> | codersync --restore-all|-r | codersync --list-all|-l | codersync --kill|-k <ids> | codersync --kill-all|-K | codersync --paste-image|-p | codersync --sync-skills|-y | codersync --local|-L <session-name> | codersync --adopt|-d" >&2
    echo "Run 'codersync --help' for more." >&2
    exit 1
    ;;
  *)
    load_config
    parse_run_args "$@"
    split_tools "$TOOLS"
    if ! tools_split_is_valid "$TOOLS"; then
      echo "codersync: --tools '${TOOLS}' is malformed -- expected two comma-separated values (e.g. claude,codex) or a single value to use for both: no empty slot on either side of the comma, and no more than one comma total (a literal command can't contain a comma -- codersync only ever runs two tools, left and right)." >&2
      exit 1
    fi
    # --split-mode iterm has no fallback (unlike tmux mode, which prints
    # the attach command when iTerm2 isn't available) -- checked here,
    # before any remote work at all, not left to open_tab() to discover
    # after the fact. Without this, remote_setup already created live
    # tmux sessions and launch scripts by the time open_tab's osascript
    # call failed locally, leaving that remote state behind with no
    # local tab ever opened (confirmed live, on a machine without
    # iTerm2 installed).
    if [[ "$SPLIT_MODE" == "iterm" ]] && ! iterm2_available; then
      echo "codersync: --split-mode iterm requires iTerm2 (and osascript control of it) -- none detected. Use --split-mode tmux instead, or install iTerm2 and try again." >&2
      exit 1
    fi
    # The (sanitized) ssh-target is folded into the session name by
    # default (e.g. `codersync foo` on target `devbox.example.com` becomes
    # session `devbox.example.com-foo`), so tmux session names/tab titles/
    # registry entries stay unambiguous if you ever use codersync against
    # more than one box. A leading numeric ID is folded in too (e.g.
    # `1-devbox.example.com-foo`), reused across repeat invocations of
    # the same name so re-running doesn't mint a duplicate session --
    # see --list-all/--kill for what the ID is actually for.
    #
    # ID lookup/allocation + the registry write that reserves it are
    # locked and done UP FRONT, before the slow remote SSH setup below --
    # so a second concurrent invocation for the SAME name sees this one's
    # reservation already in the registry and reuses it, without holding
    # the lock through the network round-trip (which would otherwise
    # serialize every codersync invocation against every other one, even
    # for unrelated names).
    acquire_id_lock || exit 1
    trap 'release_id_lock' EXIT
    SESSION_SUFFIX="${TARGET_LABEL}-${RAW_NAME}"
    SESSION="$(find_or_assign_id "$SSH_TARGET" "$SESSION_SUFFIX")"
    register_session "$SESSION"
    # Marks the registry entry just written above as still-being-created
    # (see mark_pending) -- written BEFORE id.lock is released, not
    # after, so there's no window where the entry is registered but not
    # yet marked pending for restore_all/kill_all_sessions to race into
    # (confirmed live: writing the marker after releasing id.lock let
    # --restore-all delete the entry in that exact gap). mark_pending
    # takes its own separate pending.lock internally rather than
    # id.lock -- mkdir-based locks aren't reentrant, and id.lock is
    # still held here.
    mark_pending "$SESSION"
    trap 'clear_pending "$SESSION"; release_id_lock' EXIT
    release_id_lock
    if [[ "$SPLIT_MODE" == "tmux" ]]; then
      remote_setup_tmux_mode "$SESSION" "$TOOL1" "$TOOL2" "$SAFE_MODE"
      open_tab_tmux_mode "$SESSION"
    else
      remote_setup "$SESSION" "$TOOL1" "$TOOL2" "$SAFE_MODE"
      open_tab "$SESSION"
    fi
    trap - EXIT
    clear_pending "$SESSION"
    ;;
esac
fi
